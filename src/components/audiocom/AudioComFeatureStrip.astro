---
/*
  The audio.com forward link at the foot of every feature page.

  This site's design language sells by recreating the real interface
  (the laptop tour, workspaces, effect windows) — never with stock
  photography. So the pitch here is a small rebuilt audio.com player
  card: "this is what your track looks like shared", with the track
  name derived from the feature page it sits on (vocal-remover-mix.wav
  on the vocal remover page). Placed AFTER each page's own download
  CTA so the download keeps priority; one component, all 17 pages,
  via FeaturePageLayout.
*/
import { getImage } from "astro:assets";
import audiocomBackground from "../../assets/img/audiocom-background.webp";
import AudioComSVG from "../inlineSVG/AudioComSVG";
import JoinAudioDotComButton from "../button/JoinAudioDotComButton";

/*
  Track title from the page's own slug: /features/vocal-remover/ shows
  vocal-remover-mix.wav. Falls back for anything unexpected.
*/
const slug = Astro.url.pathname.split("/").filter(Boolean).pop() ?? "my";
const track = `${slug}-mix.wav`;

/*
  A deterministic waveform: pseudo-random bar heights seeded from the
  slug so each page gets its own shape, but every build renders the
  same one (no hydration or snapshot churn).
*/
const seed = [...slug].reduce((a, c) => a + c.charCodeAt(0), 0);
const bars = Array.from({ length: 56 }, (_, i) => {
  const n = Math.sin(seed + i * 1.7) * Math.cos(seed * 0.3 + i * 0.9);
  return 20 + Math.round(Math.abs(n) * 80);
});
const playedUntil = 22;

const bg = await getImage({
  src: audiocomBackground,
  format: "webp",
  width: 1600,
  quality: 60,
});
---

<section
  class="bg-background-dark bg-cover bg-center"
  style={`background-image: linear-gradient(100deg, rgba(10, 13, 26, 0.92) 0%, rgba(10, 13, 26, 0.6) 55%, rgba(10, 13, 26, 0.35) 100%), url(${bg.src});`}
>
  <div
    class="mx-auto flex max-w-screen-lg flex-col gap-8 px-6 py-12 xs:px-12 md:flex-row md:items-center md:gap-16 md:px-8 md:py-16"
  >
    <div class="flex flex-1 flex-col items-start gap-4">
      <AudioComSVG className="h-7 text-white" />
      <h2
        class="font-harmony text-32 md:text-40 leading-tight text-text-contrast"
      >
        Share your audio on audio.com
      </h2>
      <p class="text-16 text-text-contrast/70">
        Upload your track from Audacity and share it with a link.
      </p>
      <JoinAudioDotComButton
        client:load
        label="Try audio.com"
        large
        href="https://audio.com/audacity/auth/sign-in?mtm_campaign=audacityteamorg&mtm_content=Feature_footer"
        matomoEventName="feature page strip"
      />
    </div>

    {/* The player: your track, as audio.com shows it. Decorative. */}
    <div
      class="w-full max-w-xs shrink-0 self-center rounded-xl bg-white p-4 shadow-[0_16px_40px_rgba(0,0,0,0.35)]"
      aria-hidden="true"
    >
      <div class="flex items-center gap-3">
        <div
          class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-accent"
        >
          <svg width="12" height="14" viewBox="0 0 12 14" fill="none">
            <path d="M0 0L12 7L0 14V0Z" fill="white"></path>
          </svg>
        </div>
        <div class="min-w-0">
          <p class="truncate text-16 font-semibold text-text-primary">
            {track}
          </p>
          <p class="text-12 text-text-primary/50">you &middot; just now</p>
        </div>
      </div>
      <div class="mt-4 flex h-12 items-center gap-[2px]">
        {
          bars.map((h, i) => (
            <span
              class={`w-full rounded-full ${i < playedUntil ? "bg-accent" : "bg-text-primary/15"}`}
              style={`height: ${h}%`}
            />
          ))
        }
      </div>
      <div
        class="mt-3 flex items-center justify-between text-12 tabular-nums text-text-primary/40"
      >
        <span>1:07</span>
        <span>2:54</span>
      </div>
    </div>
  </div>
</section>
