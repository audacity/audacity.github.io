---
/*
  Hub search: a full-width field that dims the page on focus and expands
  results beneath itself.

  Deliberately not the manual sidebar's dropdown, and deliberately not a
  centred modal. The field stays where it is, so there's no jump to
  re-orient against — the scrim does the focusing work instead. MDN, Stripe
  and Astro all dim the page behind search; they just move the field to do
  it. Keeping it in place is the same idea with less motion.

  ARIA follows the combobox pattern rather than dialog: this is a text input
  with a list of suggestions, not a window. Input owns aria-expanded and
  aria-activedescendant; the panel is a listbox of options.

  Degrades in two steps: with no JavaScript the form GETs /search, and if the
  Pagefind bundle is missing (it only exists after `pagefind --site dist`)
  the form keeps doing exactly that.
*/
const GROUP_ORDER = ["Manual", "Features", "FAQ", "Blog"] as const;
---

<div class="help-search" data-help-search>
  <form action="/search" method="get" role="search" class="relative">
    <label for="hub-q" class="sr-only">Search Audacity help</label>
    <input
      type="search"
      id="hub-q"
      name="q"
      role="combobox"
      aria-expanded="false"
      aria-controls="hub-results"
      aria-autocomplete="list"
      autocomplete="off"
      placeholder="Search the manual, guides, FAQ and features…"
      class="w-full h-14 pl-12 pr-4 rounded-lg border border-text-contrast/20 bg-text-contrast/5 text-18 text-text-contrast placeholder:text-text-contrast/40 focus:outline-none focus:border-accent focus:bg-text-contrast/10 transition-colors"
    />
    <svg
      class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 h-5 w-5 fill-text-contrast/40"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path
        d="M10 2a8 8 0 1 0 4.9 14.32l5.39 5.39 1.42-1.42-5.39-5.39A8 8 0 0 0 10 2m0 2a6 6 0 1 1 0 12 6 6 0 0 1 0-12"
      ></path>
    </svg>

    <!-- Results -->
    <div
      id="hub-results"
      class="hub-panel absolute left-0 right-0 top-[calc(100%+0.5rem)] rounded-lg bg-white shadow-2xl border border-text-primary/10 overflow-hidden"
      hidden
    >
      <div
        class="max-h-[min(60vh,30rem)] overflow-y-auto"
        role="listbox"
        aria-label="Search results"
        data-list
      >
      </div>
      <div
        class="flex items-center justify-between gap-4 px-4 py-2.5 border-t border-text-primary/10 bg-background-light/60"
      >
        <p class="text-12 text-text-primary/50" data-hint>
          <kbd class="font-sans font-semibold">↑</kbd>
          <kbd class="font-sans font-semibold">↓</kbd> to navigate ·
          <kbd class="font-sans font-semibold">↵</kbd> to open ·
          <kbd class="font-sans font-semibold">esc</kbd> to close
        </p>
        <a
          href="/search"
          class="shrink-0 text-12 font-semibold text-accent hover:underline underline-offset-4"
          data-see-all
          hidden>See all results</a
        >
      </div>
    </div>
  </form>
</div>

<div class="help-scrim" data-help-scrim hidden></div>

<style is:global>
  /* Above the sticky nav (z-50) so the whole page dims, as MDN and Stripe do. */
  .help-scrim {
    position: fixed;
    inset: 0;
    z-index: 60;
    background: rgb(3 0 18 / 0.6);
    opacity: 0;
    transition: opacity 160ms ease;
  }
  .help-scrim[data-visible="true"] {
    opacity: 1;
  }
  .help-search {
    position: relative;
  }
  .help-search[data-open="true"] {
    z-index: 70;
  }
  .hub-panel mark {
    background: transparent;
    color: #ff3254;
    font-weight: 600;
  }
  .hub-option[data-active="true"] {
    background: rgb(255 50 84 / 0.08);
  }
  @media (prefers-reduced-motion: reduce) {
    .help-scrim {
      transition: none;
    }
  }
</style>

<script is:inline define:vars={{ GROUP_ORDER }}>
  (function () {
    var root = document.querySelector("[data-help-search]");
    var scrim = document.querySelector("[data-help-scrim]");
    if (!root || !scrim) return;

    var input = root.querySelector("#hub-q");
    var panel = root.querySelector("#hub-results");
    var list = panel.querySelector("[data-list]");
    var seeAll = panel.querySelector("[data-see-all]");
    var form = root.querySelector("form");

    var pagefind = null;
    var options = [];
    var active = -1;
    var token = 0;

    function esc(s) {
      return String(s == null ? "" : s).replace(/[&<>"']/g, function (c) {
        return {
          "&": "&amp;",
          "<": "&lt;",
          ">": "&gt;",
          '"': "&quot;",
          "'": "&#39;",
        }[c];
      });
    }

    function open() {
      if (root.getAttribute("data-open") === "true") return;
      root.setAttribute("data-open", "true");
      input.setAttribute("aria-expanded", "true");
      scrim.hidden = false;
      requestAnimationFrame(function () {
        scrim.setAttribute("data-visible", "true");
      });
    }

    function close() {
      root.setAttribute("data-open", "false");
      input.setAttribute("aria-expanded", "false");
      input.removeAttribute("aria-activedescendant");
      panel.hidden = true;
      scrim.removeAttribute("data-visible");
      setTimeout(function () {
        if (root.getAttribute("data-open") !== "true") scrim.hidden = true;
      }, 180);
      active = -1;
    }

    function setActive(i) {
      if (!options.length) return;
      active = (i + options.length) % options.length;
      options.forEach(function (el, n) {
        var on = n === active;
        el.setAttribute("data-active", on ? "true" : "false");
        el.setAttribute("aria-selected", on ? "true" : "false");
        if (on) {
          input.setAttribute("aria-activedescendant", el.id);
          el.scrollIntoView({ block: "nearest" });
        }
      });
    }

    function render(groups, total, q) {
      var html = "";
      GROUP_ORDER.forEach(function (name) {
        var items = groups[name];
        if (!items || !items.length) return;
        html +=
          '<p class="px-4 pt-3 pb-1 text-11 font-semibold uppercase tracking-wider text-text-primary/40">' +
          esc(name) +
          "</p>";
        items.forEach(function (d) {
          html +=
            '<a role="option" aria-selected="false" class="hub-option block px-4 py-2.5 hover:bg-accent/5" href="' +
            esc(d.url) +
            '">' +
            '<span class="block text-16 font-semibold text-text-primary">' +
            esc(d.meta && d.meta.title ? d.meta.title : d.url) +
            "</span>" +
            '<span class="block text-14 text-text-primary/55 line-clamp-1">' +
            d.excerpt +
            "</span></a>";
        });
      });

      if (!html) {
        list.innerHTML =
          '<p class="px-4 py-6 text-16 text-text-primary/60">No results for "' +
          esc(q) +
          '"</p>';
        seeAll.hidden = true;
        options = [];
      } else {
        list.innerHTML = html;
        options = Array.prototype.slice.call(
          list.querySelectorAll(".hub-option"),
        );
        options.forEach(function (el, n) {
          el.id = "hub-option-" + n;
          el.addEventListener("mousemove", function () {
            setActive(n);
          });
        });
        seeAll.hidden = false;
        seeAll.textContent =
          "See all " + total + (total === 1 ? " result" : " results");
        seeAll.href = "/search?q=" + encodeURIComponent(q);
        setActive(0);
      }
      panel.hidden = false;
    }

    async function run(q) {
      var mine = ++token;
      if (!q || !pagefind) {
        panel.hidden = true;
        options = [];
        return;
      }
      var res = await pagefind.search(q);
      if (mine !== token) return;

      var top = await Promise.all(
        res.results.slice(0, 12).map(function (r) {
          return r.data();
        }),
      );
      if (mine !== token) return;

      var groups = {};
      top.forEach(function (d) {
        var t = (d.filters && d.filters.type && d.filters.type[0]) || "Other";
        (groups[t] = groups[t] || []).push(d);
      });
      // cap each group so one section can't crowd out the rest
      Object.keys(groups).forEach(function (k) {
        groups[k] = groups[k].slice(0, 4);
      });
      render(groups, res.results.length, q);
    }

    var timer = null;
    input.addEventListener("input", function () {
      open();
      clearTimeout(timer);
      timer = setTimeout(function () {
        run(input.value.trim());
      }, 160);
    });

    input.addEventListener("focus", function () {
      open();
      if (input.value.trim()) run(input.value.trim());
    });

    input.addEventListener("keydown", function (e) {
      if (e.key === "Escape") {
        close();
        input.blur();
        return;
      }
      if (panel.hidden) return;
      if (e.key === "ArrowDown") {
        e.preventDefault();
        setActive(active + 1);
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        setActive(active - 1);
      } else if (e.key === "Enter" && active >= 0 && options[active]) {
        e.preventDefault();
        window.location.href = options[active].getAttribute("href");
      }
    });

    // Submitting with nothing selected falls through to the results page.
    form.addEventListener("submit", function () {
      close();
    });

    scrim.addEventListener("click", close);
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape") close();
    });
    document.addEventListener("click", function (e) {
      if (!root.contains(e.target) && root.getAttribute("data-open") === "true")
        close();
    });

    (async function init() {
      try {
        pagefind = await import("/pagefind/pagefind.js");
        await pagefind.options({ excerptLength: 15 });
        await pagefind.filters();
      } catch (err) {
        // No index (dev server, or an unbuilt deploy): the form still works.
        console.warn("[HelpSearch] Pagefind unavailable, form falls back", err);
      }
    })();
  })();
</script>
