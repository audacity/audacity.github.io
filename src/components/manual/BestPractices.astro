---
/*
  A thin wrapper over Callout: best practices are the tip flavour with a
  standing title. One callout anatomy across the manual — note, tip,
  warning, best practices, pitfalls — differing only in label and edge.
*/
import Callout from "./Callout.astro";

interface Props {
  title?: string;
}

const { title = "Best practices" } = Astro.props;
---

<Callout type="tip" title={title}>
  <slot />
</Callout>
