---
import { STREAMS, type StreamId } from "./streams";

/*
  Banner header for the manual's landing pages.

  Gives each landing the same shape: a mark, the section name, what it's for,
  and how much of it there is. The count is the honest bit — a reader deciding
  whether to start the getting-started path benefits from knowing it's eight
  steps, and a section with two pages shouldn't pretend otherwise.
*/
interface Props {
  stream?: StreamId;
  title: string;
  description: string;
  /* Published pages behind this landing, shown as a count. */
  count?: number;
  /* Optional extra facts, e.g. "About twenty minutes". */
  meta?: string[];
}

const { stream, title, description, count, meta = [] } = Astro.props;

/*
  One treatment for every stream, on the palette: the per-stream pastels
  (emerald, blue, violet) were stock-Tailwind colour coding that nothing else
  on the site echoed, so they read as decoration rather than meaning. The
  streams identify themselves by name and content.
*/
const tone = "from-background-medium to-white border-text-primary/10";

const facts = [
  ...(typeof count === "number"
    ? [`${count} ${count === 1 ? "page" : "pages"}`]
    : []),
  ...meta,
];
---

<header
  class:list={[
    "not-prose mb-10 rounded-xl border bg-gradient-to-br p-6 sm:p-8",
    tone,
  ]}
>
  <p class="text-xs font-semibold uppercase tracking-wide text-text-primary/50">
    Audacity 4 manual
  </p>

  <h1 class="mt-2 text-4xl lg:text-5xl text-text-primary">{title}</h1>

  <p class="mt-3 max-w-2xl text-lg text-text-primary/60">{description}</p>

  {
    facts.length > 0 && (
      <ul class="mt-5 flex flex-wrap gap-x-5 gap-y-2 text-sm text-text-primary/50">
        {facts.map((f) => (
          <li>{f}</li>
        ))}
      </ul>
    )
  }
</header>
