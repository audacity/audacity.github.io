---
import { type StreamId } from "./streams";
import { getStreamEntryPoints } from "./streamEntries";

interface Props {
  current: StreamId;
  /* On the manual's front door there's no page being read, so picking a mode
     means "take me there" — the tabs stay ordinary links. On a content page
     the reader is mid-article and only wants a different contents list, so the
     switch happens in place. */
  isHome?: boolean;
}

const { current, isHome = false } = Astro.props;

/*
  A stream with no published pages is shown but not linked — better to say the
  section exists and is empty than to hide it and have readers wonder where the
  tutorials went. Once a page is filed into it, it becomes a link on its own.
*/
const streams = await getStreamEntryPoints();
---

<nav
  aria-label="Documentation sections"
  class="mb-6"
  data-stream-nav
  data-home={isHome ? "true" : "false"}
>
  {
    /*
    Boxed so the three modes read as one control rather than three loose
    links sitting above the contents tree — the reader needs to see at a
    glance that these are alternatives to each other.
  */
  }
  <ul class="space-y-0.5 rounded-lg border border-gray-200 bg-gray-50 p-1">
    {
      streams.map((s) => {
        const isCurrent = s.id === current;
        const isEmpty = !s.href;
        return (
          <li>
            {isEmpty ? (
              <span
                class="flex items-center justify-between rounded-md px-2.5 py-1.5 text-sm text-gray-400 cursor-default"
                title="No pages published in this section yet"
              >
                {s.label}
                <span class="text-xs">soon</span>
              </span>
            ) : (
              <a
                href={s.href}
                data-stream-tab={s.id}
                aria-current={isCurrent ? "true" : undefined}
                class:list={[
                  "flex items-center justify-between rounded-md px-2.5 py-1.5 text-sm transition-colors",
                  isCurrent
                    ? "bg-white text-blue-700 font-semibold shadow-sm"
                    : "text-gray-600 hover:bg-white/70 hover:text-blue-700",
                ]}
              >
                {s.label}
                <span class="text-xs text-gray-400">{s.count}</span>
              </a>
            )}
          </li>
        );
      })
    }
  </ul>
</nav>

{
  /*
  Progressive enhancement. Without JS these stay ordinary links and switching
  streams is a normal navigation — the same behaviour as before. With JS the
  click is intercepted and the already-rendered panel is revealed instead, so
  changing tabs is instant and the page never reloads.

  The URL is deliberately left alone: the reader is still on the same page, and
  only the contents list has changed. Following a link from the newly shown
  tree navigates as usual, and that page's own stream then drives the sidebar.
*/
}
<script>
  const nav = document.querySelector("[data-stream-nav]");
  // On the front door the links navigate; only enhance on content pages.
  const enhance = nav?.getAttribute("data-home") !== "true";
  const tabs = enhance
    ? document.querySelectorAll("[data-stream-tab]")
    : ([] as unknown as NodeListOf<Element>);
  const panels = document.querySelectorAll("[data-stream-panel]");

  function show(stream: string) {
    panels.forEach((p) => {
      const el = p as HTMLElement;
      el.hidden = el.dataset.streamPanel !== stream;
    });
    tabs.forEach((t) => {
      const el = t as HTMLElement;
      const active = el.dataset.streamTab === stream;
      el.setAttribute("aria-current", active ? "true" : "false");
      el.classList.toggle("bg-white", active);
      el.classList.toggle("shadow-sm", active);
      el.classList.toggle("text-blue-700", active);
      el.classList.toggle("font-semibold", active);
      el.classList.toggle("text-gray-600", !active);
    });
  }

  tabs.forEach((tab) => {
    tab.addEventListener("click", (event) => {
      const stream = (tab as HTMLElement).dataset.streamTab;
      if (!stream) return;
      // Let modified clicks (new tab, download) behave normally.
      const e = event as MouseEvent;
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0)
        return;
      event.preventDefault();
      show(stream);
    });
  });
</script>
