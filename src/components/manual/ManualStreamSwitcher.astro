---
import { getCollection } from "astro:content";
import { STREAMS, type StreamId } from "./streams";

interface Props {
  current: StreamId;
}

const { current } = Astro.props;

/*
  A stream with no published pages is shown but not linked — better to say the
  section exists and is empty than to hide it and have readers wonder where the
  tutorials went. Once a page is filed into it, it becomes a link on its own.
*/
const entries = await getCollection("manual", ({ data }) => !data.draft);

const streams = STREAMS.map((s) => {
  const pages = entries
    .filter((e) => e.data.stream === s.id)
    .sort((a, b) => {
      if (a.data.sectionOrder !== b.data.sectionOrder)
        return a.data.sectionOrder - b.data.sectionOrder;
      if (a.data.order !== b.data.order) return a.data.order - b.data.order;
      return a.slug.localeCompare(b.slug);
    });
  return { ...s, count: pages.length, firstSlug: pages[0]?.slug };
});
---

<nav aria-label="Documentation sections" class="mb-6">
  <ul class="space-y-1">
    {
      streams.map((s) => {
        const isCurrent = s.id === current;
        const isEmpty = s.count === 0;
        return (
          <li>
            {isEmpty ? (
              <span
                class="flex items-center justify-between rounded px-2 py-1.5 text-sm text-gray-400 cursor-default"
                title="No pages published in this section yet"
              >
                {s.label}
                <span class="text-xs">soon</span>
              </span>
            ) : (
              <a
                href={`/manual/${s.firstSlug}`}
                aria-current={isCurrent ? "page" : undefined}
                class:list={[
                  "flex items-center justify-between rounded px-2 py-1.5 text-sm transition-colors",
                  isCurrent
                    ? "bg-blue-50 text-blue-700 font-semibold"
                    : "text-gray-700 hover:bg-gray-50 hover:text-blue-700",
                ]}
              >
                {s.label}
                <span class="text-xs text-gray-400">{s.count}</span>
              </a>
            )}
          </li>
        );
      })
    }
  </ul>
</nav>
