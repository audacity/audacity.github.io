---
import { type StreamId } from "./streams";
import { getStreamEntryPoints } from "./streamEntries";

interface Props {
  current: StreamId;
}

const { current } = Astro.props;

/*
  A stream with no published pages is shown but not linked — better to say the
  section exists and is empty than to hide it and have readers wonder where the
  tutorials went. Once a page is filed into it, it becomes a link on its own.
*/
const streams = await getStreamEntryPoints();
---

<nav aria-label="Documentation sections" class="mb-6">
  {
    /*
    Boxed so the three modes read as one control rather than three loose
    links sitting above the contents tree — the reader needs to see at a
    glance that these are alternatives to each other.
  */
  }
  <ul
    class="space-y-0.5 rounded-lg border border-text-primary/10 bg-background-light p-1"
  >
    {
      streams.map((s) => {
        const isCurrent = s.id === current;
        const isEmpty = !s.href;
        return (
          <li>
            {isEmpty ? (
              <span
                class="flex items-center justify-between rounded-md px-2.5 py-1.5 text-sm text-text-primary/40 cursor-default"
                title="No pages published in this section yet"
              >
                {s.label}
                <span class="text-xs">soon</span>
              </span>
            ) : (
              <a
                href={s.href}
                aria-current={isCurrent ? "true" : undefined}
                class:list={[
                  "flex items-center justify-between rounded-md px-2.5 py-1.5 text-sm transition-colors",
                  isCurrent
                    ? "bg-white text-accent font-semibold shadow-sm"
                    : "text-text-primary/60 hover:bg-white/70 hover:text-accent",
                ]}
              >
                {s.label}
                <span class="text-xs text-text-primary/40">{s.count}</span>
              </a>
            )}
          </li>
        );
      })
    }
  </ul>
</nav>

{
  /*
  Progressive enhancement. Without JS these stay ordinary links and switching
  streams is a normal navigation — the same behaviour as before. With JS the
  click is intercepted and the already-rendered panel is revealed instead, so
  changing tabs is instant and the page never reloads.

  The URL is deliberately left alone: the reader is still on the same page, and
  only the contents list has changed. Following a link from the newly shown
  tree navigates as usual, and that page's own stream then drives the sidebar.
*/
}
