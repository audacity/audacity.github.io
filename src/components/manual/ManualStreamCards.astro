---
import { getStreamEntryPoints } from "./streamEntries";

/*
  Landing-page entry points into the three documentation modes, in the shape
  Astro's own docs use: name the mode, say who it's for, link in. A mode with
  nothing published yet says so plainly rather than linking to an empty page.
*/
const cards = await getStreamEntryPoints();
---

<ul class="grid grid-cols-1 md:grid-cols-3 gap-4 not-prose mb-10">
  {
    cards.map((c) => (
      <li>
        {c.href ? (
          <a
            href={c.href}
            class="flex h-full flex-col rounded-lg border border-text-primary/10 p-4 hover:border-accent hover:bg-accent/5 transition-colors"
          >
            <span class="font-semibold text-text-primary">{c.label}</span>
            <span class="mt-1 text-sm text-text-primary/60">{c.blurb}</span>
            <span class="mt-3 text-xs text-text-primary/40">
              {c.count} {c.count === 1 ? "page" : "pages"}
            </span>
          </a>
        ) : (
          <div class="flex h-full flex-col rounded-lg border border-dashed border-text-primary/10 p-4">
            <span class="font-semibold text-text-primary/50">{c.label}</span>
            <span class="mt-1 text-sm text-text-primary/50">{c.blurb}</span>
            <span class="mt-3 text-xs text-text-primary/40">Coming soon</span>
          </div>
        )}
      </li>
    ))
  }
</ul>
