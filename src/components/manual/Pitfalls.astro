---
/*
  A thin wrapper over Callout: pitfalls are the warning flavour with a
  standing title. The old version was a red banner with a cross badge —
  the loudest element on any page it appeared on, shouting over the
  content it framed.
*/
import Callout from "./Callout.astro";

interface Props {
  title?: string;
}

const { title = "Pitfalls to avoid" } = Astro.props;
---

<Callout type="warning" title={title}>
  <slot />
</Callout>
