---
import { Image } from "astro:assets";

/**
 * Pixel-true screenshot of a real application component, rendered from the
 * Audacity source by the shotbox harness (~/code/audacity-shotbox) and
 * delivered as the versioned @dilsonspickles/audacity-ui-screenshots package.
 *
 * Sibling of UIExample: UIExample renders interactive design-system
 * re-implementations; UIShot shows the actual application, captured at 4x.
 *
 *   import UIShot from "../../../components/manual/UIShot.astro";
 *   <UIShot name="trackpanel/WaveTrackItem" alt="A stereo track header" />
 *   <UIShot name="buttons/FlatButton-accent" state="hover" theme="dark" />
 *
 * `name` is the shot id from the package manifest (category/Component);
 * `state` appends an interaction-state suffix (normal/hover/pressed/disabled)
 * for shots that declare states. Images render at their logical 1x size
 * (from the manifest) unless `width` overrides it.
 *
 * Degrades to a visible placeholder (plus a build warning) when the package
 * or a specific image is missing — content never breaks the build.
 */
interface Props {
  name: string;
  state?: string;
  theme?: "light" | "dark";
  alt?: string;
  width?: number;
}

const { name, state, theme = "light", alt = "", width } = Astro.props;

const PKG = "/node_modules/@dilsonspickles/audacity-ui-screenshots";

/*
  Globbed as ImageMetadata, not ?url: the URL form hands Astro a string it
  can only pass through, so the page served the 4x PNG masters untouched —
  several megabytes each. As metadata they go through the asset pipeline
  below and come out as WebP at the sizes actually displayed.
*/
const images = import.meta.glob<ImageMetadata>(
  "/node_modules/@dilsonspickles/audacity-ui-screenshots/{light,dark}/**/*.png",
  { eager: true, import: "default" },
);
const manifests = import.meta.glob<{
  scale: number;
  images: { id: string; width: number; height: number }[];
}>("/node_modules/@dilsonspickles/audacity-ui-screenshots/manifest.json", {
  eager: true,
  import: "default",
});

const id = `${name}${state ? `-${state}` : ""}`;
const image = images[`${PKG}/${theme}/${id}.png`];
const meta = Object.values(manifests)[0]?.images.find((i) => i.id === id);

if (!image) {
  console.warn(
    `UIShot: no image for "${id}" (${theme}) — is @dilsonspickles/audacity-ui-screenshots installed and does the shot exist?`,
  );
}

// Explicit dimensions reserve the layout box before the image loads (no
// layout shift). A width override scales height proportionally.
/*
  Flyout shots are transparent PNGs of a popup that already carries the
  application's own shadow, so a CSS shadow and radius would draw a rectangle
  around the transparency. Only opaque captures get the framed treatment.
*/
const framed = !name.startsWith("flyouts/");

/*
  Clip screenshots carry their own radius-4 outline in the pixels; the
  frame's 8px CSS radius cut across it and shaved the corners off the
  outline. They get a radius that matches the one they were drawn with.
*/
const tightRadius = name.startsWith("trackpanel/WaveClip");

const displayWidth = width ?? meta?.width;
const displayHeight =
  meta && displayWidth
    ? Math.round((meta.height * displayWidth) / meta.width)
    : undefined;
---

{
  image ? (
    <figure class="ui-shot not-prose my-6 flex flex-col items-center rounded-lg border border-text-primary/10 bg-background-light px-6 py-8">
      {/*
        densities [1, 2] so retina displays get a 2x source, and quality 100
        because these are UI screenshots: sharp's WebP default of 80 is tuned
        for photographs, where ringing hides in texture. On flat panels, 1px
        borders and small text it shows as exactly the softness a reader
        notices in a screenshot of an interface.
      */}
      <Image
        class={
          framed
            ? tightRadius
              ? "ui-shot-img ui-shot-img--tight"
              : "ui-shot-img"
            : undefined
        }
        src={image}
        alt={alt}
        width={displayWidth}
        height={displayHeight}
        densities={[1, 2]}
        format="webp"
        quality={100}
        loading="lazy"
        decoding="async"
        draggable="false"
      />
      {Astro.slots.has("default") && (
        <figcaption class="mt-3 text-sm text-text-primary/50">
          <slot />
        </figcaption>
      )}
    </figure>
  ) : (
    <em>Screenshot unavailable ({id})</em>
  )
}

<style>
  /* Belt and braces alongside draggable="false": Safari needs user-drag,
     and disabling selection stops drag-select ghosting around the figure. */
  .ui-shot img {
    -webkit-user-drag: none;
    user-select: none;
    -webkit-user-select: none;
  }

  /*
    The screenshots are captured on the app's own background, so on the
    figure's light ground their edges just stop. Rounded corners and a soft
    drop shadow read as "this is a picture of the interface" rather than a
    fragment of page — the same treatment the handout used.
  */
  .ui-shot :global(.ui-shot-img) {
    border-radius: 8px;
    box-shadow:
      0 1px 2px rgb(15 0 77 / 0.08),
      0 4px 12px rgb(15 0 77 / 0.12);
  }

  /* After the base rule on purpose: same specificity, so order decides. */
  .ui-shot :global(.ui-shot-img--tight) {
    border-radius: 4px;
  }
</style>
