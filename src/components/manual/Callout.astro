---
/*
  Restyled onto the design system: the old version was stock Tailwind
  blue/emerald/amber — the same off-palette colours the brand sweep removed
  from the rest of the site — and three loudly tinted boxes on one page read
  as a fruit salad. One calm surface now, with the type carried by the left
  edge and a small uppercase label:

    info    — quiet: a neutral edge in the text colour
    tip     — the deep brand purple
    warning — the accent, which is the palette's only red

  Body copy stays at 16 rather than the old text-sm: callouts hold real
  guidance (the feedback-howl warning, the FFmpeg note), not fine print.
*/
interface Props {
  type?: "info" | "tip" | "warning";
  title?: string;
}

const { type = "info", title } = Astro.props;

const styles = {
  info: {
    edge: "border-l-text-primary/25",
    label: "text-text-primary/50",
    defaultTitle: "Note",
  },
  tip: {
    edge: "border-l-text-primary",
    label: "text-text-primary",
    defaultTitle: "Tip",
  },
  warning: {
    edge: "border-l-accent",
    label: "text-accent",
    defaultTitle: "Warning",
  },
};

const style = styles[type];
const heading = title ?? style.defaultTitle;
---

<aside
  class:list={[
    "not-prose my-8 rounded-r-lg border-l-4 bg-background-light px-5 py-4",
    style.edge,
  ]}
>
  <p
    class:list={[
      "text-12 uppercase tracking-wider font-semibold mb-2",
      style.label,
    ]}
  >
    {heading}
  </p>
  <div class="text-16 leading-relaxed text-text-primary/80 callout-body">
    <slot />
  </div>
</aside>

<style>
  .callout-body :global(> * + *) {
    margin-top: 0.75rem;
  }
  .callout-body :global(ul),
  .callout-body :global(ol) {
    padding-left: 1.25rem;
    list-style: disc;
  }
  .callout-body :global(li + li) {
    margin-top: 0.375rem;
  }
  .callout-body :global(a) {
    color: #ff3254;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
