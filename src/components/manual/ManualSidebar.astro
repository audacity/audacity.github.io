---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import ManualSearch from "./ManualSearch.astro";
import ManualSidebarTree, { type TreeNode } from "./ManualSidebarTree.astro";
import ManualStreamSwitcher from "./ManualStreamSwitcher.astro";
import { DEFAULT_STREAM, type StreamId } from "./streams";
import { VIRTUAL_MANUAL_ENTRIES } from "./virtualEntries";

interface Props {
  currentSlug: string;
  /* Which documentation mode the reader is in. The sidebar shows only that
     stream's pages; the switcher above moves between them. */
  currentStream?: StreamId;
}

const { currentSlug, currentStream = DEFAULT_STREAM } = Astro.props;

/* The tree only ever reads id + data.{title,section,sectionOrder,order},
   so pages that live outside the collection (the generated shortcuts
   reference) join in as structurally-equal entries rather than pretending
   to be CollectionEntry.

   `id`, not `slug`: Astro 6's content layer renamed the field, and this list
   mixes real collection entries with virtual ones. Keyed on `slug` the
   virtual entries came through with `id` undefined and the tree sort threw
   on localeCompare. VIRTUAL_MANUAL_ENTRIES keeps its own `slug` field — it
   isn't a collection — so it's mapped across here. */
type Entry = Pick<CollectionEntry<"manual">, "id"> & {
  data: Pick<
    CollectionEntry<"manual">["data"],
    "title" | "section" | "sectionOrder" | "order"
  >;
};

const collectionEntries = await getCollection(
  "manual",
  ({ data }) => !data.draft && data.stream === currentStream,
);

const virtualEntries: Entry[] = VIRTUAL_MANUAL_ENTRIES.filter(
  (v) => v.stream === currentStream,
).map((v) => ({
  id: v.slug,
  data: {
    title: v.title,
    section: v.section,
    sectionOrder: v.sectionOrder,
    order: v.order,
  },
}));

const allEntries: Entry[] = [...collectionEntries, ...virtualEntries];

const grouped = new Map<string, { sectionOrder: number; entries: Entry[] }>();
for (const entry of allEntries) {
  const existing = grouped.get(entry.data.section);
  if (existing) {
    existing.entries.push(entry);
  } else {
    grouped.set(entry.data.section, {
      sectionOrder: entry.data.sectionOrder,
      entries: [entry],
    });
  }
}

/**
 * Build a nested tree from a flat list of entries by using the slug path as
 * the hierarchy. An entry whose slug is `foo/bar/baz` becomes a child of
 * `foo/bar` if that entry exists in the set, otherwise of `foo`, otherwise
 * a root.
 */
function buildTree(entries: Entry[]): TreeNode[] {
  const sorted = [...entries].sort((a, b) => {
    if (a.data.order !== b.data.order) return a.data.order - b.data.order;
    return a.id.localeCompare(b.id);
  });

  const nodes = new Map<string, TreeNode>();
  for (const entry of sorted) {
    nodes.set(entry.id, {
      title: entry.data.title,
      slug: entry.id,
      order: entry.data.order,
      children: [],
    });
  }

  const roots: TreeNode[] = [];
  for (const entry of sorted) {
    const node = nodes.get(entry.id)!;
    const parts = entry.id.split("/");
    let attached = false;
    for (let i = parts.length - 1; i > 0; i--) {
      const parentSlug = parts.slice(0, i).join("/");
      const parent = nodes.get(parentSlug);
      if (parent) {
        parent.children.push(node);
        attached = true;
        break;
      }
    }
    if (!attached) roots.push(node);
  }
  return roots;
}

/*
  When a section holds exactly one root page and everything else nests under
  it, the section label and that page are the same thing twice — EFFECTS with
  a lone "Effects" parent inside it. In that case the heading itself becomes
  the link and the root's children move up a level; the root page loses no
  reachability, only its duplicate row.
*/
const sections = Array.from(grouped.entries())
  .sort((a, b) => a[1].sectionOrder - b[1].sectionOrder)
  .map(([name, { entries }]) => {
    const tree = buildTree(entries);
    const active = entries.some((e) => e.id === currentSlug);
    if (tree.length === 1 && tree[0].children.length > 0) {
      return {
        name,
        active,
        href: `/manual/${tree[0].slug}`,
        tree: tree[0].children,
      };
    }
    return { name, active, href: null, tree };
  });
---

<div class="space-y-6">
  <ManualSearch filterType="Manual" />

  <ManualStreamSwitcher current={currentStream} />

  <nav aria-label="Manual" class="text-sm">
    {
      /*
        Sections are collapsible the same way tree nodes are — same classes,
        so the chevron CSS and the localStorage script drive both. The split
        hit target is deliberate: the label navigates to the section's index
        page (where one exists), the chevron toggles. A heading that only
        toggles wastes the index pages; one that only navigates leaves a
        ~150-row sidebar permanently unfolded. Only the section holding the
        current page starts open.
      */
      sections.map((section) => (
        <div
          class="manual-tree__item mb-4"
          data-slug={`section:${section.name}`}
          data-has-children="true"
          data-active={section.active ? "true" : undefined}
          data-state={section.active ? "open" : "closed"}
        >
          <div class="flex items-center gap-1">
            <h2 class="flex-1 text-xs font-semibold uppercase tracking-wide text-gray-500">
              {section.href ? (
                <a
                  href={section.href}
                  class:list={[
                    "block py-1 hover:text-blue-700 transition-colors",
                    `/manual/${currentSlug}` === section.href &&
                      "text-blue-700",
                  ]}
                >
                  {section.name}
                </a>
              ) : (
                <span class="block py-1">{section.name}</span>
              )}
            </h2>
            <button
              type="button"
              class="manual-tree__toggle shrink-0 p-1 rounded text-gray-400 hover:text-gray-700 hover:bg-gray-100"
              aria-label={`Toggle ${section.name}`}
              data-tree-toggle
            >
              <svg
                class="w-3.5 h-3.5 transition-transform"
                viewBox="0 0 16 16"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <polyline points="4 6 8 10 12 6" />
              </svg>
            </button>
          </div>
          <ManualSidebarTree
            nodes={section.tree}
            currentSlug={currentSlug}
            depth={0}
          />
        </div>
      ))
    }
  </nav>
</div>

<style is:global>
  /* The Astro-style group line: a section's children sit slightly offset with
     one rule running down their left, so the group reads as a block hanging
     from its heading. Nested branches keep their own deeper lines. */
  .manual-tree__item[data-slug^="section:"] > .manual-tree {
    margin-left: 0.375rem;
    margin-top: 0.25rem;
    padding-left: 0.75rem;
    border-left: 1px solid rgb(229 231 235);
  }

  /* Hide children of a collapsed tree node; rotate the chevron when open. */
  .manual-tree__item[data-state="closed"] > .manual-tree {
    display: none;
  }
  .manual-tree__item[data-state="open"] > div > .manual-tree__toggle svg {
    transform: rotate(0deg);
  }
  .manual-tree__item[data-state="closed"] > div > .manual-tree__toggle svg {
    transform: rotate(-90deg);
  }
</style>

<script is:inline>
  (function () {
    const STORAGE_KEY = "manual-tree-state";
    let stored = {};
    try {
      stored = JSON.parse(localStorage.getItem(STORAGE_KEY) || "{}");
    } catch (e) {
      stored = {};
    }

    function setState(item, state) {
      item.dataset.state = state;
      const slug = item.dataset.slug;
      if (slug) {
        stored[slug] = state;
        try {
          localStorage.setItem(STORAGE_KEY, JSON.stringify(stored));
        } catch (e) {}
      }
    }

    // Apply stored overrides on top of the server-rendered initial state.
    document
      .querySelectorAll('.manual-tree__item[data-has-children="true"]')
      .forEach((item) => {
        const slug = item.dataset.slug;
        // Never let a remembered "closed" hide the section or branch the
        // reader is currently inside — the page they are on always wins.
        if (item.dataset.active === "true") return;
        if (slug && stored[slug] === "open") item.dataset.state = "open";
        else if (slug && stored[slug] === "closed")
          item.dataset.state = "closed";
      });

    // Toggle on chevron click.
    document.querySelectorAll("[data-tree-toggle]").forEach((toggle) => {
      toggle.addEventListener("click", (e) => {
        e.preventDefault();
        const item = toggle.closest(".manual-tree__item");
        if (!item) return;
        const next = item.dataset.state === "open" ? "closed" : "open";
        setState(item, next);

        // Sections behave as an accordion: opening one closes the rest, so
        // the sidebar never regrows to the 150-row wall. Tree branches
        // inside a section stay independent.
        const slug = item.dataset.slug || "";
        if (slug.startsWith("section:") && next === "open") {
          document
            .querySelectorAll('.manual-tree__item[data-slug^="section:"]')
            .forEach((other) => {
              if (other !== item && other.dataset.state === "open") {
                setState(other, "closed");
              }
            });
        }
      });
    });
  })();
</script>
