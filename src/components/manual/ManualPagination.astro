---
import { getCollection } from "astro:content";
import { DEFAULT_STREAM, type StreamId } from "./streams";

interface Props {
  currentSlug: string;
  /* Prev/next stay within one documentation mode — walking off the end of the
     tutorials into the middle of the reference would be disorienting. */
  currentStream?: StreamId;
}

const { currentSlug, currentStream = DEFAULT_STREAM } = Astro.props;

const entries = (
  await getCollection(
    "manual",
    ({ data }) => !data.draft && data.stream === currentStream,
  )
).sort((a, b) => {
  if (a.data.sectionOrder !== b.data.sectionOrder) {
    return a.data.sectionOrder - b.data.sectionOrder;
  }
  return a.data.order - b.data.order;
});

const index = entries.findIndex((e) => e.id === currentSlug);
const prev = index > 0 ? entries[index - 1] : null;
const next =
  index >= 0 && index < entries.length - 1 ? entries[index + 1] : null;
---

{
  (prev || next) && (
    <nav
      class="not-prose mt-12 pt-6 border-t border-text-primary/10 grid grid-cols-1 sm:grid-cols-2 gap-4"
      aria-label="Manual pagination"
    >
      {prev ? (
        <a
          href={`/manual/${prev.id}`}
          class="group flex flex-col gap-1 rounded-lg border border-text-primary/10 hover:border-accent px-4 py-3 transition-colors"
        >
          <span class="text-xs uppercase tracking-wide text-text-primary/50 inline-flex items-center gap-1">
            <svg
              class="w-3.5 h-3.5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <line x1="19" y1="12" x2="5" y2="12" />
              <polyline points="12 19 5 12 12 5" />
            </svg>
            Previous
          </span>
          <span class="text-base font-semibold text-text-primary group-hover:text-accent">
            {prev.data.title}
          </span>
        </a>
      ) : (
        <span />
      )}
      {next ? (
        <a
          href={`/manual/${next.id}`}
          class="group flex flex-col gap-1 rounded-lg border border-text-primary/10 hover:border-accent px-4 py-3 transition-colors text-right sm:items-end"
        >
          <span class="text-xs uppercase tracking-wide text-text-primary/50 inline-flex items-center gap-1">
            Next
            <svg
              class="w-3.5 h-3.5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <line x1="5" y1="12" x2="19" y2="12" />
              <polyline points="12 5 19 12 12 19" />
            </svg>
          </span>
          <span class="text-base font-semibold text-text-primary group-hover:text-accent">
            {next.data.title}
          </span>
        </a>
      ) : (
        <span />
      )}
    </nav>
  )
}
