---
import "../../styles/fonts.css";
import {
  hasDownloadAssets,
  preReleaseList,
} from "../../assets/data/audacityReleases";
import MuseHubLockupSVG from "../inlineSVG/MuseHubLockupSVG";
import MuseGroupLockupSVG from "../inlineSVG/MuseGroupLockupSVG";
import AudioComLockupSVG from "../inlineSVG/AudioComLockupSVG";
import FacebookSVG from "../inlineSVG/FacebookSVG";
import InstagramSVG from "../inlineSVG/InstagramSVG";
import TwitterSVG from "../inlineSVG/TwitterSVG";
import YoutubeSVG from "../inlineSVG/YoutubeSVG";
import DiscordSVG from "../inlineSVG/DiscordSVG";
import { useTranslations } from "../../i18n";

const t = useTranslations(Astro.currentLocale);
const localePrefix =
  Astro.currentLocale && Astro.currentLocale !== "en"
    ? `/${Astro.currentLocale}`
    : "";

const links = [
  { href: "/help", label: t("footer.link.help") },
  { href: "/FAQ", label: t("footer.link.faq") },
  /* Literal, not a t() key: main added the page without one, and inventing a
     key here would leave every other locale falling back to a missing string. */
  { href: "/contact", label: "Contact" },
  { href: "/blog", label: t("footer.link.blog") },
  /*
    Restored: this branch lost it in the footer redesign. It's the only route
    to the privacy notice, cookie policy, accessibility statement and VPAT —
    the sole other link to any of them is inside the cookie banner, which is
    gone once a visitor accepts, leaving all five pages built but unreachable.
  */
  { href: "/legal", label: t("footer.link.legal") },
  { href: "/cloud-saving", label: t("footer.link.cloudSaving") },
  {
    href: "https://forum.audacityteam.org/",
    label: t("footer.link.forum"),
    external: true,
  },
  {
    href: "https://merch.audacityteam.org/",
    label: t("footer.link.merch"),
    external: true,
    badge: "NEW",
  },
  { href: "/manual", label: t("footer.link.manual") },
  { href: "https://audio.com/", label: "Audio.com", external: true },
];

/*
  Was computed further down and never read. Now it gates the Beta link below:
  that link was hardcoded, so it survived isActive being turned off and went on
  advertising a pre-release that resolves (via the /beta -> /next redirect) to
  "Pre-release downloads are currently unavailable".

  Gating it here means isActive in audacityReleases.ts is the single switch for
  promoting a pre-release, which is what every other consumer already assumes.
*/
const hasPreRelease = preReleaseList.some(
  (entry) => entry.isActive && hasDownloadAssets(entry.downloads),
);

const downloads = [
  { href: "/download/windows", label: "Windows" },
  { href: "/download/mac", label: "macOS" },
  { href: "/download/linux", label: "Linux" },
  ...(hasPreRelease
    ? [{ href: "/beta", label: t("footer.download.beta"), id: "beta-link" }]
    : []),
  {
    href: "https://www.musehub.com/app/audacity?utm_medium=Referral&utm_source=AU&utm_campaign=MH_WW_REF_AU_ALL_ALL_030926_crosslink&utm_content=footer",
    label: "MuseHub",
    external: true,
  },
  {
    href: "https://www.musehub.com/plugin?utm_medium=Referral&utm_source=AU&utm_campaign=MH_WW_REF_AU_ALL_ALL_030926_crosslink&utm_content=footer",
    label: "Plugins",
    external: true,
  },
];

const social = [
  {
    href: "https://www.facebook.com/Audacity/",
    label: "Facebook",
    external: true,
  },
  { href: "https://x.com/getaudacity?lang=en", label: "X", external: true },
  {
    href: "https://www.instagram.com/audacityteam/",
    label: "Instagram",
    external: true,
  },
  {
    href: "https://www.youtube.com/c/audacity",
    label: "YouTube",
    external: true,
  },
  { href: "https://discord.gg/audacity", label: "Discord", external: true },
];

/* The same MuseHub plugin destinations and campaign as the homepage's
   Top-5 section, with utm_content marking these as footer clicks. */
const MUSEHUB_UTM =
  "utm_medium=Referral&utm_source=au&utm_campaign=MH_WW_REF_AU_WEB_ALL_030926_crosslink&utm_content=footer";
const plugins = [
  {
    href: `https://www.musehub.com/plugin/openvino-ai-tools?${MUSEHUB_UTM}`,
    label: "OpenVino",
    external: true,
  },
  {
    href: `https://www.musehub.com/plugin/musefx?${MUSEHUB_UTM}`,
    label: "MuseFX",
    external: true,
  },
  {
    href: `https://www.musehub.com/plugin/landr-fx-voice?${MUSEHUB_UTM}`,
    label: "LandrFX Voice",
    external: true,
  },
  {
    href: `https://www.musehub.com/plugin/soap-voice-cleaner?${MUSEHUB_UTM}`,
    label: "Soap Voice Cleaner",
    external: true,
  },
  {
    href: `https://www.musehub.com/plugin/graillon-3?${MUSEHUB_UTM}`,
    label: "Graillon",
    external: true,
  },
];
---

<footer class="bg-background-deep py-12">
  <div class="max-w-screen-xl mx-auto px-8">
    <div class="grid grid-cols-1 lg:grid-cols-[2fr_4fr] gap-8 lg:gap-12">
      <!-- Brand Column -->
      <div class="flex flex-col justify-between">
        <div>
          <p class="font-harmony text-64 text-accent">Audacity</p>
          <p class="text-12 mt-2 text-text-contrast/75">
            Copyright &copy; <span id="copyright"></span> | {
              t("footer.copyright")
            }.
          </p>
        </div>
      </div>

      <!-- Link Groups Container -->
      <div
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 pt-8 lg:pt-4 border-t border-text-contrast/20 lg:border-t-[1px]"
      >
        <!-- Links Column -->
        <div>
          <p class="font-harmony text-32 text-text-contrast">
            {t("footer.nav.links")}
          </p>
          <ul class="mt-2 space-y-2 md:space-y-0">
            {
              links.map((link) => (
                <li class="w-fit">
                  <a
                    href={
                      link.external ? link.href : `${localePrefix}${link.href}`
                    }
                    aria-label={
                      link.external
                        ? `External link to ${link.label}`
                        : `Link to ${link.label}`
                    }
                    target={link.external ? "_blank" : undefined}
                    class="text-text-contrast/75 hover:text-accent hover:underline transition-colors"
                  >
                    {link.badge ? <b>{link.label}</b> : link.label}
                    {link.badge && (
                      <sup class="ml-1 px-1.5 py-0.3 rounded bg-red-600 text-white text-12 font-semibold">
                        {link.badge}
                      </sup>
                    )}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Downloads Column -->
        <div>
          <p class="font-harmony text-32 text-text-contrast">
            {t("footer.nav.downloads")}
          </p>
          <ul class="mt-2 space-y-2 md:space-y-0">
            {
              downloads.map((link) => (
                <li id={link.id} class="w-fit">
                  <a
                    href={
                      link.external ? link.href : `${localePrefix}${link.href}`
                    }
                    aria-label={
                      link.external
                        ? `External link to ${link.label}`
                        : `Link to ${link.label}`
                    }
                    target={link.external ? "_blank" : undefined}
                    class="text-text-contrast/75 hover:text-accent hover:underline transition-colors"
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Social Column -->
        <div>
          <p class="font-harmony text-32 text-text-contrast">
            {t("footer.nav.social")}
          </p>
          <ul class="mt-2 space-y-2 md:space-y-0">
            {
              social.map((link) => (
                <li class="w-fit">
                  <a
                    href={link.href}
                    aria-label={`External link to ${link.label}`}
                    target="_blank"
                    class="text-text-contrast/75 hover:text-accent hover:underline transition-colors"
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Plugins Column -->
        <div>
          <p class="font-harmony text-32 text-text-contrast">
            {t("footer.nav.plugins")}
          </p>
          <ul class="mt-2 space-y-2 md:space-y-0">
            {
              plugins.map((link) => (
                <li class="w-fit">
                  <a
                    href={
                      link.external ? link.href : `${localePrefix}${link.href}`
                    }
                    aria-label={
                      link.external
                        ? `External link to ${link.label}`
                        : `Link to ${link.label}`
                    }
                    target={link.external ? "_blank" : undefined}
                    class="text-text-contrast/75 hover:text-accent hover:underline transition-colors"
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

    <!-- Social Icons Row -->
    <div
      class="mt-12 pt-8 border-t border-text-contrast/20 flex items-center justify-between"
    >
      <div class="flex gap-4">
        {
          social.map((link) => (
            <a
              href={link.href}
              aria-label={`External link to ${link.label}`}
              target="_blank"
              class="text-accent hover:text-text-contrast transition-colors"
            >
              {link.label === "Facebook" ? (
                <FacebookSVG client:load />
              ) : link.label === "Instagram" ? (
                <InstagramSVG client:load />
              ) : link.label === "X" ? (
                <TwitterSVG client:load />
              ) : link.label === "YouTube" ? (
                <YoutubeSVG client:load />
              ) : link.label === "Discord" ? (
                <DiscordSVG client:load />
              ) : (
                link.label
              )}
            </a>
          ))
        }
      </div>
    </div>

    <!-- Logos Row -->
    <div
      class="mt-8 pt-8 border-t border-text-contrast/20 grid grid-cols-1 lg:grid-cols-[2fr_4fr] gap-8 lg:gap-12 items-center"
    >
      <a
        href="https://www.mu.se/?utm_medium=Referral&utm_source=audacity&utm_campaign=MG_WW_REF_ADCT_WEB_ALL_160226_Crosslink"
        target="_blank"
        rel="noopener"
        aria-label="Muse Group"
        class="group w-fit"
      >
        <MuseGroupLockupSVG
          className="h-12 text-text-contrast opacity-50 transition-opacity group-hover:opacity-100"
        />
      </a>
      <div class="flex flex-wrap gap-8 items-center">
        <a
          href="https://www.musehub.com/?utm_medium=Referral&utm_source=audacity&utm_campaign=MH_WW_REF_ADCT_WEB_ALL_160226_Crosslink"
          target="_blank"
          rel="noopener"
          aria-label="Muse Hub"
          class="group w-fit"
        >
          <MuseHubLockupSVG
            className="h-12 text-text-contrast opacity-50 transition-opacity group-hover:opacity-100"
          />
        </a>
        <a
          href="https://audio.com/redirect/af?ac_target=https%3A%2F%2Faudio.com%2F%3Futm_medium%3DREF%26utm_source%3Daudacity%26utm_campaign%3DAC_WW_REF_ADCT_ALL_ALL_160226&utm_medium=REF&utm_source=audacity&utm_campaign=AC_WW_REF_ADCT_ALL_ALL_160226"
          target="_blank"
          rel="noopener"
          aria-label="Audio.com"
          class="group w-fit"
        >
          <AudioComLockupSVG
            className="h-12 text-text-contrast opacity-50 transition-opacity group-hover:opacity-100"
          />
        </a>
      </div>
    </div>
  </div>
</footer>

<script>
  const elem = document.querySelector("#copyright");
  if (elem) elem.textContent = new Date().getFullYear().toString();
</script>
