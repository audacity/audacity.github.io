---
/*
  One spot of the "promo-spot" experiment. The homepage renders all four;
  every one is hidden by default and CSS (input.css) reveals the one matching
  the visitor's data-exp-promo-spot arm, set before paint by the BaseLayout
  bootstrap. Nothing here hydrates — a small script runs dismissal and
  analytics.

  Layout follows the "Without countdown" frames in Figma: a 48px campaign
  bar (A above the nav with a turquoise rule, B under the hero), a sticky
  pill (C) and a sale card in the Top-5 block's place (D).
*/
import {
  saleSpotCopy as copy,
  saleSpotHref,
  type SaleSpotArm,
} from "../../assets/data/promos/saleSpot";

interface Props {
  arm: SaleSpotArm;
}

const { arm } = Astro.props;
const href = saleSpotHref(arm);
const dismissible = arm === "a" || arm === "c";
// Spelled out, not built from `arm`: input.css reveals these per arm, and
// Tailwind drops any rule whose class never appears literally in the source.
const spotClass = {
  a: "promo-spot promo-spot-a",
  b: "promo-spot promo-spot-b",
  c: "promo-spot promo-spot-c",
  d: "promo-spot promo-spot-d",
}[arm];
---

{
  arm === "d" ? (
    <div
      class:list={[spotClass, "w-full min-w-0 md:w-1/2"]}
      data-promo-arm={arm}
    >
      <div class="flex flex-col gap-6">
        {/*
          One line at every width from md up, in the 48px the video's heading
          occupies, so the card's top edge sits level with the thumbnail's.
        */}
        <h2 class="font-harmony text-32 text-text-primary md:flex md:h-12 md:items-center md:whitespace-nowrap md:text-24 lg:text-32 xl:text-40">
          {copy.cardHeading}
        </h2>
        {/*
          Same box as the release video beside it: both columns are md:w-1/2
          under identical headings, and the thumbnail is w-full aspect-video,
          so a 16:9 card lands at the same height at every width. Type steps
          down below xl so the content fits the box in the narrower md/lg
          columns; at xl the column is 576px and the sizes are Figma's.
        */}
        <div class="grid w-full sm:aspect-video sm:grid-cols-[1fr_140px] xl:grid-cols-[1fr_200px] overflow-hidden rounded-lg bg-musehub-onyx">
          <div class="flex min-h-0 flex-col p-4 text-musehub-turquoise lg:p-6">
            <p class="border-t border-musehub-turquoise pt-1.5 font-sans text-16 font-medium leading-tight tracking-[0.3px] lg:pt-2 lg:text-20">
              {copy.cardDates}
            </p>
            <p class="mt-2 border-y border-musehub-turquoise py-2 font-harmony text-40 leading-none lg:mt-3 lg:py-3 lg:text-56 xl:text-[80px] xl:leading-[1.2]">
              {copy.cardTitle}
            </p>
            <a
              href={href}
              target="_blank"
              rel="noopener"
              data-promo-link
              class="mt-4 flex items-center justify-center rounded-full bg-musehub-turquoise px-3 py-2.5 text-center font-sans text-16 font-medium leading-5 text-musehub-onyx hover:brightness-110 transition sm:mt-auto lg:px-5 lg:py-[14px] lg:text-20 lg:leading-6"
            >
              {copy.cardButton}
            </a>
          </div>
          <div class="relative flex min-h-[160px] flex-col overflow-hidden bg-musehub-turquoise p-4 text-musehub-onyx sm:min-h-0 lg:p-6">
            <svg
              class="pointer-events-none absolute left-[55px] top-1/2 size-[200px] -translate-y-1/2 opacity-30 xl:left-[75px] xl:size-[264px]"
              viewBox="0 0 264 264"
              fill="none"
              stroke="currentColor"
              aria-hidden="true"
            >
              <circle cx="132" cy="132" r="131.5" />
              <circle cx="132" cy="132" r="107.5" />
              <circle cx="132" cy="132" r="83" />
            </svg>
            <p class="relative font-sans text-[13px] font-medium leading-tight tracking-[0.3px] lg:text-[15px] lg:leading-5 xl:w-[152px]">
              {copy.cardOfferLabel}
            </p>
            <p class="relative flex flex-1 items-center font-harmony text-48 leading-none lg:text-64 xl:text-[96px]">
              {copy.cardDiscount}
            </p>
          </div>
        </div>
      </div>
    </div>
  ) : (
    <div
      class:list={[
        spotClass,
        arm === "c" &&
          "fixed inset-x-4 z-40 mx-auto w-auto max-w-fit bottom-[calc(var(--promo-sticky-offset,0px)+1rem)] transition-[bottom] duration-500",
      ]}
      data-promo-arm={arm}
    >
      <div
        class:list={[
          "flex items-center justify-center bg-musehub-onyx text-text-contrast",
          arm === "c"
            ? "gap-4 rounded-full py-3 pl-6 pr-3 shadow-[0_0_28px_rgba(0,212,255,0.28),0_14px_40px_-6px_rgba(0,0,0,0.35)] md:gap-7 md:py-4 md:pl-8"
            : "relative min-h-12 gap-8 px-14 py-1.5",
          arm === "a" && "border-b border-musehub-turquoise",
        ]}
      >
        <a
          href={href}
          target="_blank"
          rel="noopener"
          data-promo-link
          class:list={[
            "flex flex-wrap items-center justify-center gap-y-1",
            arm === "c" ? "gap-x-4 md:gap-x-7" : "gap-x-8",
          ]}
        >
          <span
            class:list={[
              "font-harmony leading-none",
              arm === "c"
                ? "text-20 tracking-[0.3px] md:text-[26px]"
                : "text-20 md:text-[28px]",
            ]}
          >
            {copy.barLead}{" "}
            <span class="text-musehub-turquoise">{copy.barOffer}</span>
          </span>
          <span
            class:list={[
              "flex items-center rounded-full bg-musehub-turquoise font-sans text-[15px] font-medium leading-5 text-musehub-onyx whitespace-nowrap",
              arm === "c" ? "px-[22px] py-3" : "h-9 px-3",
            ]}
          >
            {copy.barButton}
          </span>
        </a>
        {dismissible && (
          <button
            type="button"
            data-promo-dismiss
            aria-label={copy.dismiss}
            class:list={[
              "flex size-10 shrink-0 items-center justify-center text-text-contrast/80 hover:text-text-contrast",
              arm === "a" && "absolute right-4 top-1/2 -translate-y-1/2",
            ]}
          >
            <svg
              class={arm === "c" ? "size-[18px]" : "size-4"}
              viewBox="0 0 16 16"
              aria-hidden="true"
            >
              <path
                d="M2 2l12 12M14 2L2 14"
                stroke="currentColor"
                stroke-width="1.5"
              />
            </svg>
          </button>
        )}
      </div>
    </div>
  )
}

<script>
  import "../../assets/js/saleSpot.js";
</script>
