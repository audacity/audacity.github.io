---
/*
  One spot of the "promo-spot" experiment. The homepage renders all four;
  every one is hidden by default and CSS (input.css) reveals the one matching
  the visitor's data-exp-promo-spot arm, set before paint by the BaseLayout
  bootstrap. Nothing here hydrates — a small script runs dismissal and
  analytics.

  Layout follows the "Without countdown" frames in Figma: a 48px campaign
  bar (A above the nav with a turquoise rule, B under the hero), a sticky
  pill (C) and a sale card in the Top-5 block's place (D).
*/
import {
  saleSpotCopy as copy,
  saleSpotHref,
  type SaleSpotArm,
} from "../../assets/data/promos/saleSpot";

interface Props {
  arm: SaleSpotArm;
}

const { arm } = Astro.props;
const href = saleSpotHref(arm);
const dismissible = arm === "a" || arm === "c";
// Spelled out, not built from `arm`: input.css reveals these per arm, and
// Tailwind drops any rule whose class never appears literally in the source.
const spotClass = {
  a: "promo-spot promo-spot-a",
  b: "promo-spot promo-spot-b",
  c: "promo-spot promo-spot-c",
  d: "promo-spot promo-spot-d",
}[arm];
---

{
  arm === "d" ? (
    <div
      class:list={[spotClass, "w-full min-w-0 md:w-1/2"]}
      data-promo-arm={arm}
    >
      <div class="flex flex-col gap-4">
        {/* Same scale as the headings in ReleaseVideo.astro; keep in step. */}
        <h2 class="font-harmony text-32 text-text-primary md:text-24 md:leading-[48px] min-[896px]:text-32 min-[896px]:leading-[48px] min-[1104px]:text-40">
          {copy.cardHeading}
        </h2>
        {/*
          Same box as the release video beside it: both columns are md:w-1/2
          under identical headings, and the thumbnail is w-full aspect-video,
          so a 16:9 card lands at the same height at every width. Type steps
          down below xl so the content fits the box in the narrower md/lg
          columns; at xl the column is 576px and the sizes are Figma's.
        */}
        {/*
          Between sm and md the section is stacked and the card is full
          width, so the offer panel takes the Large banner's share (375 of
          983, about 38%) rather than the two-column widths.
        */}
        <div class="grid w-full sm:aspect-video sm:grid-cols-[1fr_38%] md:grid-cols-[1fr_140px] xl:grid-cols-[1fr_200px] overflow-hidden rounded-lg bg-musehub-onyx">
          {/*
            The column is a size container so the title can be sized from
            the column's own width: "Holiday Sale" in Harmony is about 3.6×
            its font size wide, so 27cqw of the column fills the line at
            every width. Below sm the card is full width and the clamp's
            ceiling takes over.
          */}
          <div class="flex min-h-0 flex-col p-4 text-musehub-turquoise [container-type:inline-size] lg:p-6">
            {/*
              Below sm the card follows the Mobile banner in Figma: 15px
              eyebrow 8px under the top rule, then a 64px title in a 120px
              block between two rules (12px above and below a 96px line).
            */}
            <p class="border-t border-musehub-turquoise pt-2 font-sans text-[15px] font-medium leading-5 tracking-[0.3px] sm:pt-1.5 sm:text-16 sm:leading-tight lg:pt-2 lg:text-20">
              {copy.cardDates}
            </p>
            <p class="mt-2 whitespace-nowrap border-y border-musehub-turquoise py-3 font-harmony text-[64px] leading-[1.5] sm:py-2 sm:text-[clamp(40px,27cqw,96px)] sm:leading-none lg:mt-3 lg:py-3">
              {copy.cardTitle}
            </p>
          </div>
          {/*
            The offer panel is a size container too. In the Large banner the
            discount is 176px in a 375px panel, 47% of its width, and the
            rings are 110% of it, so both scale from the panel here: 94px in
            the 200px panel at xl, 66px at md, and far larger when the card
            is full width between sm and md.
          */}
          {/*
            The panel itself is the size container and carries no padding:
            cqw resolves against a container's content box, so padding on
            the container would shrink every cqw measure below by 32–48px.
            The padding sits on the inner wrapper instead.

            Below sm the panel is the Mobile banner's: 16px padding, 15px
            label, 4px gap, then the discount at 96px on a 176px line.

            Sound rings, from the Figma assets: 1px onyx stroke at 17%
            opacity. In the Mobile banner the three rings are not
            concentric — they share one right edge and one centre line, so
            they nest towards the right: diameters 246/200/155 in a 343px
            panel, right edge 60px past the panel's, centre 92px down. In
            the Large banner (the sm–lg reference) they are concentric at
            109% of the panel, centred 76.5% across; in the 200px panel of
            the site's own frame (xl) they are 264px, centred 103.5% across,
            so only their left arcs show. Both are vertically centred.
          */}
          <div class="relative overflow-hidden bg-musehub-turquoise text-musehub-onyx [container-type:inline-size]">
            <svg
              class="pointer-events-none absolute right-[-17.5cqw] top-[-9cqw] size-[72cqw] opacity-[0.17] sm:hidden"
              viewBox="0 0 246 246"
              fill="none"
              stroke="currentColor"
              aria-hidden="true"
            >
              <circle
                cx="123"
                cy="123"
                r="122.5"
                vector-effect="non-scaling-stroke"
              />
              <circle
                cx="145.8"
                cy="123"
                r="100.2"
                vector-effect="non-scaling-stroke"
              />
              <circle
                cx="168.6"
                cy="123"
                r="77.4"
                vector-effect="non-scaling-stroke"
              />
            </svg>
            <svg
              class="pointer-events-none absolute left-[22cqw] top-1/2 hidden size-[110cqw] -translate-y-1/2 opacity-[0.17] sm:block xl:left-[37.5cqw] xl:size-[132cqw]"
              viewBox="0 0 264 264"
              fill="none"
              stroke="currentColor"
              aria-hidden="true"
            >
              <circle
                cx="132"
                cy="132"
                r="131.5"
                vector-effect="non-scaling-stroke"
              />
              <circle
                cx="132"
                cy="132"
                r="107.5"
                vector-effect="non-scaling-stroke"
              />
              <circle
                cx="132"
                cy="132"
                r="83"
                vector-effect="non-scaling-stroke"
              />
            </svg>
            {/*
              The discount is 47% of the panel width in the Large banner and
              48% (96px of 200) in the site's frame, vertically centred in
              the panel. It is centred on the panel wherever the label leaves
              room for that (sm, xl); in the narrow md/lg panels the label
              runs to four or five lines, so there it centres in the space
              under the label instead.
            */}
            <div class="relative flex h-full flex-col gap-1 p-4 sm:gap-0 lg:p-6">
              <p class="relative font-sans text-[15px] font-medium leading-5 tracking-[0.3px] sm:text-16 sm:leading-tight md:text-[13px] lg:text-[15px] lg:leading-5 xl:w-[152px]">
                {copy.cardOfferLabel}
              </p>
              <p class="font-harmony text-[96px] leading-[176px] sm:absolute sm:left-4 sm:top-1/2 sm:-translate-y-1/2 sm:text-[47cqw] sm:leading-none md:static md:flex md:flex-1 md:translate-y-0 md:items-center xl:absolute xl:left-6 xl:top-1/2 xl:-translate-y-1/2 xl:text-[48cqw]">
                {copy.cardDiscount}
              </p>
            </div>
          </div>
        </div>
        <a
          href={href}
          target="_blank"
          rel="noopener"
          data-promo-link
          class="mt-2 w-full rounded-full bg-musehub-turquoise px-[22px] py-3 text-center font-sans text-[15px] font-medium leading-5 text-musehub-onyx hover:brightness-110 transition sm:w-fit"
        >
          {copy.cardButton}
        </a>
      </div>
    </div>
  ) : (
    <div
      class:list={[
        spotClass,
        arm === "c" &&
          "fixed inset-x-4 z-40 mx-auto w-auto max-w-fit bottom-[calc(var(--promo-sticky-offset,0px)+1rem)] transition-[bottom] duration-500",
      ]}
      data-promo-arm={arm}
    >
      {/*
        The bars (A, B) are a fixed 48px tall at every width, the rule on A
        included (border-box). Below md they follow "Campaign bar / Mobile"
        in the MH Sales Campaign file for everything but height: 16px left
        and 8px right padding, 8px gaps, one 20px Harmony line in turquoise
        ("MuseHub: Up to 50% off") that clips rather than wraps, a 36px
        button and a 36px close. The button keeps "Shop the sale" down to
        xs (480px) and is the frame's one-word "Shop" only below that,
        where the 375px bar would clip the message. From md they are the
        desktop campaign bar. The sticky pill (C) keeps its shape and takes
        the short copy below md.
      */}
      <div
        class:list={[
          "flex items-center bg-musehub-onyx text-text-contrast",
          arm === "c"
            ? "justify-center gap-2 rounded-full py-3 pl-4 pr-2 shadow-[0_0_28px_rgba(0,212,255,0.28),0_14px_40px_-6px_rgba(0,0,0,0.35)] md:gap-7 md:py-4 md:pl-8 md:pr-3"
            : "h-12 gap-2 pl-4 pr-2 md:relative md:justify-center md:gap-8 md:px-14",
          arm === "a" && "border-b border-musehub-turquoise",
        ]}
      >
        <a
          href={href}
          target="_blank"
          rel="noopener"
          data-promo-link
          class:list={[
            "flex min-w-0 items-center gap-2",
            arm === "c"
              ? "md:gap-7"
              : "flex-1 md:flex-none md:flex-wrap md:justify-center md:gap-x-8 md:gap-y-1",
          ]}
        >
          <span
            class:list={[
              "min-w-0 flex-1 truncate font-harmony text-20 leading-none text-musehub-turquoise md:flex-none md:overflow-visible md:whitespace-normal md:text-text-contrast",
              arm === "c"
                ? "tracking-[0.3px] md:text-[26px]"
                : "md:text-[28px]",
            ]}
          >
            {copy.barLead}{" "}
            <span class="text-musehub-turquoise">
              <span class="md:hidden">{copy.barOfferShort}</span>
              <span class="hidden md:inline">{copy.barOffer}</span>
            </span>
          </span>
          <span
            class:list={[
              "flex h-9 shrink-0 items-center rounded-full bg-musehub-turquoise px-3 font-sans text-[15px] font-medium leading-5 text-musehub-onyx whitespace-nowrap",
              arm === "c" && "md:h-auto md:px-[22px] md:py-3",
            ]}
          >
            <span class="xs:hidden">{copy.barButtonShort}</span>
            <span class="hidden xs:inline">{copy.barButton}</span>
          </span>
        </a>
        {dismissible && (
          <button
            type="button"
            data-promo-dismiss
            aria-label={copy.dismiss}
            class:list={[
              "flex size-9 shrink-0 items-center justify-center text-text-contrast/80 hover:text-text-contrast md:size-10",
              arm === "a" &&
                "md:absolute md:right-4 md:top-1/2 md:-translate-y-1/2",
            ]}
          >
            <svg
              class:list={["size-4", arm === "c" && "md:size-[18px]"]}
              viewBox="0 0 16 16"
              aria-hidden="true"
            >
              <path
                d="M2 2l12 12M14 2L2 14"
                stroke="currentColor"
                stroke-width="1.5"
              />
            </svg>
          </button>
        )}
      </div>
    </div>
  )
}

<script>
  import "../../assets/js/saleSpot.js";
</script>
