---
/*
  The designed tiles-and-ripples artwork, supplied as an export
  (postdownload.webp, 2688x1484). It replaces the in-code vector
  reconstruction: the design is the designer's, not an approximation.
*/
import { Image } from "astro:assets";
import artwork from "../../assets/img/postdownload.webp";
---

<Image
  src={artwork}
  alt=""
  width={720}
  densities={[1, 2]}
  quality={90}
  loading="eager"
  class="mx-auto h-auto w-full max-w-[300px]"
  aria-hidden="true"
/>
