---
// Retired from the home page in the Audacity 4 release design, where the
// Top-5 plugins list took this column. Kept whole so it can be dropped onto
// another page — the video.promo.* strings are still in every locale file.
import FeaturedVideo from "./FeaturedVideo";
import { useTranslations } from "../../i18n";

const t = useTranslations(Astro.currentLocale);

const promoVideo = {
  CTA: true,
  ctaText: t("video.promo.cta"),
  ctaURL:
    "https://www.musehub.com/plugin/playgrnd-fx?utm_source=au-web&utm_medium=mh-web-cta&utm_campaign=au-web-mh-web-playgrnd-fx",
  imageAltText: "Video thumbnail",
  label: t("video.promo.label"),
  placeholderImage: "https://i.ytimg.com/vi/UGiJCTu67Ak/maxresdefault.jpg",
  title: "PLAYGRND FX",
  videoURL: "https://www.youtube-nocookie.com/embed/UGiJCTu67Ak?autoplay=1",
};
---

<FeaturedVideo
  client:load
  title={promoVideo.title}
  label={promoVideo.label}
  placeholderImage={promoVideo.placeholderImage}
  imageAltText={promoVideo.imageAltText}
  videoURL={promoVideo.videoURL}
  CTA={promoVideo.CTA}
  ctaText={promoVideo.ctaText}
  ctaURL={promoVideo.ctaURL}
  matomoEventName={promoVideo.title}
/>
