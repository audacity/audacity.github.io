---
/*
  A captioned figure for markdown pages: the one part of a media-rich guide
  that markdown can't say on its own. Pass one image path, or the webm+mp4
  pair of a screen recording — the first source's extension picks the element.

  Framing (radius, border, width) is left to the page's prose rules so a
  figure inherits whichever layout it is dropped into, and `alt` carries the
  description either way: the alt text of an image, the aria-label of a
  video, which is what a muted autoplaying loop needs to be announced at all.
*/
const VIDEO_TYPES: Record<string, string> = {
  webm: "video/webm",
  mp4: "video/mp4",
};

interface Props {
  src: string | string[];
  alt: string;
  width?: number;
  height?: number;
  caption?: string;
}

const { src, alt, width, height, caption } = Astro.props;

const sources = Array.isArray(src) ? src : [src];
const typeOf = (path: string) =>
  VIDEO_TYPES[path.split(".").pop()?.toLowerCase() ?? ""];
const isVideo = Boolean(typeOf(sources[0]));
---

<figure>
  {
    isVideo ? (
      <video
        width={width}
        height={height}
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        aria-label={alt}
      >
        {sources.map((path) => (
          <source src={path} type={typeOf(path)} />
        ))}
      </video>
    ) : (
      <img
        src={sources[0]}
        alt={alt}
        width={width}
        height={height}
        loading="lazy"
        decoding="async"
      />
    )
  }
  {caption && <figcaption>{caption}</figcaption>}
</figure>
