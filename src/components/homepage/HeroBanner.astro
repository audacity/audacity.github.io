---
import DownloadButton from "../button/DownloadButton";
import DownloadMuseHubButton from "../button/DownloadMuseHubButton";
import { Image } from "astro:assets";
import AudacityMockUp from "../../assets/img/hero-surface-studio-darkened.webp";
import { useTranslations } from "../../i18n";

const t = useTranslations(Astro.currentLocale);
---

<section id="main" class="py-8 md:py-12 lg:py-16 bg-background-deep">
  <div
    class="mx-auto max-w-screen-lg lg:max-w-screen-xl xl:max-w-screen-xl px-6 md:px-16"
  >
    <div class="flex flex-col lg:flex-row lg:items-center gap-8 lg:gap-0">
      <!-- Left Column - Text Content -->
      <div
        class="flex flex-col text-center lg:text-left lg:w-2/5 gap-6 md:gap-8 lg:gap-10 xl:gap-14"
      >
        <div class="flex flex-col gap-3 md:gap-4">
          <p class="font-sans text-18 text-text-contrast/60">
            {t("hero.eyebrow")}
          </p>
          <h1
            class="font-harmony text-32 sm:text-40 md:text-48 lg:text-56 xl:text-64 text-text-contrast leading-tight"
          >
            {t("hero.headline")}
          </h1>
        </div>

        <div
          class="flex flex-col items-center lg:items-start text-text-contrast"
        >
          {
            /* The link centres under the button, not under the column: the
              pair share a fit-width group so the narrower link sits on the
              pill's axis at every alignment. */
          }
          <div class="flex w-fit flex-col items-center gap-4">
            <DownloadMuseHubButton surface="hero" client:load />
            <noscript>
              <DownloadMuseHubButton surface="hero" client:load />
            </noscript>
            <DownloadButton surface="hero" client:load />
            <noscript>
              <DownloadButton surface="hero" client:load />
            </noscript>
          </div>
        </div>
      </div>

      <!-- Right Column - Image -->
      <div class="lg:w-3/5 flex items-center justify-center relative">
        <Image
          src={AudacityMockUp}
          alt="A laptop showing the Audacity application"
          width={1400}
          quality={90}
          loading="eager"
          class="relative z-10 w-full max-w-[400px] lg:max-w-full h-auto"
        />
      </div>
    </div>
  </div>
</section>
