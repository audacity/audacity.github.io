---
import { Image } from "astro:assets";
import FeaturedVideo from "../video/FeaturedVideo";
import museHubBadge from "../../assets/img/musehub/musehub-badge-c-black.svg";
import { useTranslations } from "../../i18n";

const t = useTranslations(Astro.currentLocale);

// TODO: swap for the "What's New In This Version?" video once the ID is
// available — the design calls for that video, not the build-process one.
const RELEASE_VIDEO_ID = "QYM3TWf_G38";

const releaseVideo = {
  title: t("video.release.title"),
  placeholderImage: `https://i.ytimg.com/vi/${RELEASE_VIDEO_ID}/maxresdefault.jpg`,
  imageAltText: t("video.release.alt"),
  videoURL: `https://www.youtube-nocookie.com/embed/${RELEASE_VIDEO_ID}?autoplay=1`,
};

const plugins = [
  { name: "OpenVino", key: "plugins.openvino" },
  { name: "MuseFX", key: "plugins.musefx" },
  { name: "LandrFX Voice", key: "plugins.landrfxVoice" },
  { name: "Soap Voice Cleaner", key: "plugins.soapVoiceCleaner" },
  { name: "Graillon 3", key: "plugins.graillon" },
] as const;

const museHubURL =
  "https://www.musehub.com/?utm_source=au-web&utm_medium=mh-web-cta&utm_campaign=au-web-mh-top-5-plugins";
---

<section class="bg-background-light">
  <div
    class="mx-auto px-6 xs:px-12 md:px-8 py-10 md:py-12 lg:py-16 max-w-screen-lg"
  >
    <div class="flex flex-col md:flex-row gap-12 md:gap-16">
      <!-- Our latest release -->
      <div class="w-full md:w-1/2 flex flex-col gap-6">
        <h2 class="font-harmony text-32 md:text-40 text-text-primary">
          {t("release.heading")}
        </h2>
        <FeaturedVideo
          client:load
          placeholderImage={releaseVideo.placeholderImage}
          imageAltText={releaseVideo.imageAltText}
          videoURL={releaseVideo.videoURL}
          matomoEventName={releaseVideo.title}
          playButton="accent"
        />
        <p class="text-16 leading-snug text-text-primary">
          {t("release.body")}
        </p>
      </div>

      <!-- Top-5 plugins -->
      <div class="w-full md:w-1/2 flex flex-col gap-7">
        <div class="flex flex-col gap-1">
          <h2 class="font-harmony text-32 md:text-40 text-text-primary">
            {t("plugins.heading")}
          </h2>
          <p class="text-16 text-text-primary/60">{t("plugins.poweredBy")}</p>
        </div>

        <ul class="flex flex-col gap-1">
          {
            plugins.map((plugin) => (
              <li class="text-20 lg:text-24 leading-[1.4] text-gray-900">
                <span class="font-semibold text-accent">{plugin.name}.</span>{" "}
                {t(plugin.key)}
              </li>
            ))
          }
        </ul>

        <a
          href={museHubURL}
          class="w-fit hover:opacity-90 transition-opacity"
          target="_blank"
          rel="noopener"
        >
          <Image
            src={museHubBadge}
            alt={t("plugins.badgeAlt")}
            class="w-[170px] h-auto"
          />
        </a>
      </div>
    </div>

    <hr class="mt-10 md:mt-12 border-t border-text-primary/10" />
  </div>
</section>
