---
import { Image } from "astro:assets";
import FeaturedVideo from "../video/FeaturedVideo";
import museHubBadge from "../../assets/img/musehub/musehub-badge-b-black.svg";
import releaseVideoThumb from "../../assets/img/release-video-thumb.webp";
import { useTranslations } from "../../i18n";

const t = useTranslations(Astro.currentLocale);

const RELEASE_VIDEO_ID = "BTQymidLYIM";

const releaseVideo = {
  title: t("video.release.title"),
  placeholderImage: releaseVideoThumb.src,
  imageAltText: t("video.release.alt"),
  videoURL: `https://www.youtube-nocookie.com/embed/${RELEASE_VIDEO_ID}?autoplay=1`,
};

/* Campaign params supplied by Yaroslav (2 Sep 2026) for the Top-5 section. */
const MUSEHUB_UTM =
  "utm_medium=Referral&utm_source=au&utm_campaign=MH_WW_REF_AU_WEB_ALL_030926_crosslink&utm_content=top-trending-plugins";

/** Tag a MuseHub plugin URL with the section's campaign params. */
function museHubLink(slug: string) {
  return `https://www.musehub.com/plugin/${slug}?${MUSEHUB_UTM}`;
}

const plugins = [
  {
    name: "Extract:Dialogue 2",
    key: "plugins.extractDialogue",
    href: museHubLink("extractdialogue-2"),
  },
  { name: "MuseFX", key: "plugins.musefx", href: museHubLink("musefx") },
  {
    name: "LandrFX Voice",
    key: "plugins.landrfxVoice",
    href: museHubLink("landr-fx-voice"),
  },
  {
    name: "Soap Voice Cleaner",
    key: "plugins.soapVoiceCleaner",
    href: museHubLink("soap-voice-cleaner"),
  },
  {
    name: "Graillon 3",
    key: "plugins.graillon",
    href: museHubLink("graillon-3"),
  },
] as const;

const museHubURL = `https://www.musehub.com/?${MUSEHUB_UTM}`;
---

<section class="bg-background-light">
  <div
    class="mx-auto px-6 xs:px-12 md:px-8 py-10 md:py-12 lg:py-16 max-w-screen-xl"
  >
    <div
      class="flex flex-col xl:flex-row gap-12 xl:gap-16"
      data-entrance-group="120"
    >
      <!-- Our latest release -->
      <div class="w-full xl:w-1/2 flex flex-col gap-6">
        <h2 class="font-harmony text-32 md:text-40 text-text-primary">
          {t("release.heading")}
        </h2>
        <FeaturedVideo
          client:load
          placeholderImage={releaseVideo.placeholderImage}
          imageAltText={releaseVideo.imageAltText}
          videoURL={releaseVideo.videoURL}
          matomoEventName={releaseVideo.title}
          playButton="none"
        />
        <p class="text-16 leading-snug text-text-primary">
          {t("release.body")}
        </p>
        <a
          href="/about"
          class="w-fit font-muse-sans text-16 text-text-primary underline underline-offset-4 decoration-text-primary/40 hover:text-accent hover:decoration-accent transition-colors"
        >
          {t("release.learnMore")}
        </a>
      </div>

      <!-- Top-5 plugins -->
      <div class="w-full xl:w-1/2 flex flex-col gap-7">
        <div class="flex flex-col gap-1">
          <h2 class="font-harmony text-32 md:text-40 text-text-primary">
            {t("plugins.heading")}
          </h2>
          <p class="text-16 text-text-primary/60">{t("plugins.distributor")}</p>
        </div>

        <ul class="flex flex-col gap-1">
          {
            plugins.map((plugin) => (
              <li class="text-18 lg:text-20 leading-[1.4] text-gray-900">
                <a
                  href={plugin.href}
                  class="whitespace-nowrap font-semibold text-accent underline underline-offset-4 decoration-accent/40 hover:decoration-accent transition-colors"
                  target="_blank"
                  rel="noopener"
                >
                  {plugin.name}.
                </a>{" "}
                {t(plugin.key)}
              </li>
            ))
          }
        </ul>

        <a
          href={museHubURL}
          class="w-fit hover:opacity-90 transition-opacity"
          target="_blank"
          rel="noopener"
        >
          <Image
            src={museHubBadge}
            alt={t("plugins.badgeAlt")}
            class="w-[170px] h-auto"
          />
        </a>
      </div>
    </div>
  </div>
</section>
