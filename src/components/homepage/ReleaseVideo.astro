---
import { Image } from "astro:assets";
import FeaturedVideo from "../video/FeaturedVideo";
import museHubBadge from "../../assets/img/musehub/musehub-badge-b-black.svg";
import releaseVideoThumb from "../../assets/img/release-video-thumb.webp";
import { useTranslations } from "../../i18n";
import { getTopPlugins } from "../../assets/data/promotions";

const t = useTranslations(Astro.currentLocale);

const RELEASE_VIDEO_ID = "BTQymidLYIM";

const releaseVideo = {
  title: t("video.release.title"),
  placeholderImage: releaseVideoThumb.src,
  imageAltText: t("video.release.alt"),
  videoURL: `https://www.youtube-nocookie.com/embed/${RELEASE_VIDEO_ID}?autoplay=1`,
};

/* Names, taglines and campaign-tagged links come from the Confluence promo
   calendar via "bun run pull-campaigns". */
const plugins = getTopPlugins();

/* The badge carries the same campaign params as the list it sits under. */
const museHubURL = plugins[0]
  ? `https://www.musehub.com/${new URL(plugins[0].href).search}`
  : "https://www.musehub.com/";
---

<section class="bg-background-light">
  <div
    class="mx-auto px-6 xs:px-12 md:px-8 py-10 md:py-12 lg:py-16 max-w-screen-xl"
  >
    <div
      class="flex flex-col md:flex-row gap-12 md:gap-10 xl:gap-16"
      data-entrance-group="120"
    >
      <!-- Our latest release -->
      <div class="w-full md:w-1/2 flex flex-col gap-6">
        <h2 class="font-harmony text-32 md:text-40 text-text-primary">
          {t("release.heading")}
        </h2>
        <FeaturedVideo
          client:load
          placeholderImage={releaseVideo.placeholderImage}
          imageAltText={releaseVideo.imageAltText}
          videoURL={releaseVideo.videoURL}
          matomoEventName={releaseVideo.title}
          playButton="none"
        />
        <p class="text-16 leading-snug text-text-primary">
          {t("release.body")}
        </p>
        <a
          href="/audacity-4"
          class="w-fit font-muse-sans text-16 text-text-primary underline underline-offset-4 decoration-text-primary/40 hover:text-accent hover:decoration-accent transition-colors"
        >
          {t("release.learnMore")}
        </a>
      </div>

      <!-- Top-5 plugins -->
      {
        plugins.length > 0 && (
          <div class="w-full md:w-1/2 flex flex-col gap-7">
            <div class="flex flex-col gap-1">
              <h2 class="font-harmony text-32 md:text-40 text-text-primary">
                {t("plugins.heading")}
              </h2>
              <p class="text-16 text-text-primary/60">
                {t("plugins.distributor")}
              </p>
            </div>

            {/*
            Below xl the columns are too narrow for "Name. Tagline" on one
            line, so each entry stacks its tagline under the name instead
            of wrapping mid-sentence. At xl+ the entries return to the
            single-line form.
          */}
            <ul class="flex flex-col gap-2.5 xl:gap-1">
              {plugins.map((plugin) => (
                <li class="text-18 leading-[1.4] text-gray-900">
                  <a
                    href={plugin.href}
                    class="whitespace-nowrap text-accent underline underline-offset-4 decoration-accent/40 hover:decoration-accent transition-colors"
                    target="_blank"
                    rel="noopener"
                  >
                    {plugin.name}.
                  </a>{" "}
                  <span class="block xl:inline text-18 text-text-primary/80">
                    {plugin.tagline}
                  </span>
                </li>
              ))}
            </ul>

            <a
              href={museHubURL}
              class="w-fit hover:opacity-90 transition-opacity"
              target="_blank"
              rel="noopener"
            >
              <Image
                src={museHubBadge}
                alt={t("plugins.badgeAlt")}
                class="w-[170px] h-auto"
              />
            </a>
          </div>
        )
      }
    </div>
  </div>
</section>
