---
import BaseLayout from "./BaseLayout.astro";
import DownloadCard from "../components/card/DownloadCard";
import IconLinkCard from "../components/card/IconLinkCard";
import MuseHubRecommendedSection from "../components/button/MuseHubRecommendedSection";
import { Icon } from "astro-icon/components";
import "../styles/icons.css";
import { museHubReleases } from "../assets/data/museHubReleases";
import type { ReleaseInfo } from "../assets/data/audacityReleases";
import type { MuseHubReleaseInfo } from "../assets/data/museHubReleases";
import { useTranslations } from "../i18n";

export interface Props {
  title: string;
  description: string;
  OS: string;
  version: string;
  releaseData: ReleaseInfo[];
  museHubReleaseData?: MuseHubReleaseInfo[];
  iconName: string;
  iconColor: string;
}
const {
  title,
  description,
  OS,
  version,
  releaseData,
  museHubReleaseData,
  iconName,
  iconColor,
} = Astro.props;
const t = useTranslations(Astro.currentLocale);
---

<BaseLayout title={title} description={description}>
  <main class="max-w-screen-md mx-auto">
    {
      /* Left-aligned and on the display face, matching /download — the OS mark
        sits inline with the title rather than floating above it. */
    }
    <section id="main" class="px-4 sm:px-12 pt-10 md:pt-12 pb-8">
      <div class="flex flex-col gap-3">
        <div class="flex items-center gap-3">
          {
            /*
            astro-icon renders at 1em, so the mark scales from font-size
            rather than a fixed box — it tracks the heading at both
            breakpoints instead of sitting small beside it.

            Solid black, not the site accent. Apple and Microsoft both permit
            their marks in solid black or white, and both prohibit recolouring
            them into another brand's colour — which is what tinting these
            with the accent amounted to.
          */
          }
          <div
            class:list={[
              "flex shrink-0 items-center text-32 md:text-40",
              iconColor,
            ]}
          >
            <Icon name={`fa6-brands:${iconName}`} />
          </div>
          <h1
            class="font-harmony text-32 md:text-40 text-text-primary leading-tight"
          >
            {t("download.downloadFor")}
            {OS}
          </h1>
        </div>
        <p class="text-16 text-text-primary/60">
          {t("download.currentVersion")}
          <span class="text-text-primary">{version}</span>
          <span class="px-2 text-text-primary/30">|</span>
          <a
            class="text-text-primary underline underline-offset-4 decoration-text-primary/40 hover:text-accent hover:decoration-accent transition-colors"
            href="/changelog">{t("download.viewChangelog")}</a
          >
        </p>
      </div>
    </section>

    {
      OS !== "Linux" && (
        <MuseHubRecommendedSection
          client:load
          museHubReleaseData={museHubReleaseData}
          OS={OS}
        />
      )
    }

    <section class="mx-4 sm:mx-12 flex flex-col">
      {false && OS !== "Linux" && <h5>Other downloads</h5>}

      <div class="flex flex-col gap-4">
        {
          releaseData.map((item) => {
            return (
              <DownloadCard
                client:load
                OS={OS}
                title={item.name}
                checksum={item.checksum}
                downloadURL={item.browser_download_url}
                downloadType={item.type}
                downloadLabel={t("download.btn")}
                checksumLabel={t("download.checksum")}
              />
            );
          })
        }
      </div>
    </section>

    <section class="py-12 mx-4 sm:mx-12">
      <h3
        class="col-start-2 col-span-10 lg:col-start-1 lg:col-span-12 text-18 lg:text-24 text-text-primary font-semibold"
      >
        {t("download.additionalResources")}
      </h3>
      <div
        class="col-start-2 col-span-10 lg:col-start-1 lg:col-span-12 grid grid-cols-12 gap-6 mt-4 md:mt-8"
      >
        <IconLinkCard
          icon="icon-export"
          title={t("download.ffmpegDesc")}
          description="An optional library which handles additional file formats (like WMA, M4A, AC3 and others)"
          linkText="Link to FFmpeg library"
          targetURL="/manual/basics/installing-ffmpeg"
        />
        <IconLinkCard
          icon="icon-mixer"
          title="Plugins"
          description="Elevate your productions with a vast selection of plugins, sound effects, loops and more."
          linkText="Link to musehub"
          targetURL="https://musehub.com/"
        />
      </div>
    </section>

    <section class="mx-4 sm:mx-12 mb-20 xl:mb-24">
      <slot />
    </section>
  </main>
</BaseLayout>
