---
import BaseLayout from "./BaseLayout.astro";
import ManualSidebar from "../components/manual/ManualSidebar.astro";
import BackToTop from "../components/manual/BackToTop.astro";
import type { StreamId } from "../components/manual/streams";

/*
  Shared chrome for the manual's non-article pages — the front door and the
  three stream landings. Article pages keep their own layout in
  pages/manual/[...slug].astro because they also carry on-this-page and
  pagination.
*/
interface Props {
  title: string;
  description: string;
  /* Which stream's contents the sidebar should show. Omitted on the front
     door, where the sidebar falls back to its default. */
  stream?: StreamId;
}

const { title, description, stream } = Astro.props;
---

<BaseLayout title={title} description={description} showPromoBanner={false}>
  <main id="main" class="max-w-screen-2xl mx-auto">
    <div class="grid grid-cols-12 gap-x-8 pt-8 pb-32">
      <aside
        class="col-start-2 col-span-10 sm:col-start-2 sm:col-span-3 sm:sticky sm:top-8 self-start"
      >
        <ManualSidebar currentSlug={`#${stream}`} currentStream={stream} />
      </aside>

      {
        /*
        Same columns as an article page, including at xl where article pages
        shift left to clear the on-this-page rail. The rail's two columns are
        simply empty here — the content sitting in the same place on every
        manual page matters more than filling the width.
      */
      }
      {
        /*
          min-w-0: grid items refuse to shrink below their content's
          natural width, so a wide child (the reference landing's
          rendered app window) would otherwise blow the grid out and
          side-scroll the whole page instead of its own container.
        */
      }
      <article
        class="col-start-2 col-span-10 sm:col-start-6 sm:col-span-6 xl:col-start-5 xl:col-span-6 min-w-0"
      >
        <slot />
      </article>
    </div>
  </main>
  <BackToTop />
</BaseLayout>
