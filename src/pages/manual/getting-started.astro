---
import ManualLayout from "../../layouts/ManualLayout.astro";
import ManualLandingHeader from "../../components/manual/ManualLandingHeader.astro";
import { getCollection } from "astro:content";

/*
  Landing for the Getting started stream — the eight-step path that used to
  live at /learn, now inside the manual so the reader keeps the sidebar,
  search and switcher rather than leaving the docs and coming back.

  Steps are a fixed path rather than generated from the collection: this is a
  tutorial, so the order is the argument. Each step links to its page once one
  exists, and reads as plain text until then.
*/
interface Step {
  number: number;
  title: string;
  description: string;
  href?: string;
}

const pageCount = (
  await getCollection(
    "manual",
    ({ data }) => !data.draft && data.stream === "getting-started",
  )
).length;

const steps: Step[] = [
  {
    number: 1,
    title: "Install Audacity",
    href: "/manual/getting-started/install-audacity",
    description:
      "Download Audacity for Windows, macOS, or Linux and run the installer.",
  },
  {
    number: 2,
    title: "Connect your microphone",
    href: "/manual/getting-started/connect-your-microphone",
    description:
      "USB, 3.5mm, or XLR — set up the right input so Audacity hears you.",
  },
  {
    number: 3,
    title: "Make your first recording",
    href: "/manual/getting-started/make-your-first-recording",
    description:
      "Press record, check the level, and stop. Listen back to confirm the take.",
  },
  {
    number: 4,
    title: "Basic audio editing",
    href: "/manual/getting-started/basic-audio-editing",
    description:
      "Select a stretch of audio, then cut, copy, trim or silence it — and undo anything you get wrong.",
  },
  {
    number: 5,
    title: "Cut, move, and arrange clips",
    href: "/manual/getting-started/cut-move-and-arrange-clips",
    description:
      "Trim silence, drag clips into the right place, split where you need to.",
  },
  {
    number: 6,
    title: "Apply your first effect",
    href: "/manual/getting-started/apply-your-first-effect",
    description:
      "Add a compressor or a touch of EQ as a realtime effect on a track.",
  },
  {
    number: 7,
    title: "Save your project",
    href: "/manual/getting-started/save-your-project",
    description:
      "Keep the editable .aup4 project file or save to the cloud for backup.",
  },
  {
    number: 8,
    title: "Export your audio",
    href: "/manual/getting-started/export-your-audio",
    description: "Mix down to MP3, WAV, FLAC, or any format you need to share.",
  },
  {
    number: 9,
    title: "Where to go next",
    href: "/manual/getting-started/where-to-go-next",
    description:
      "Dive into the manual, browse the how-to guides, or join the community.",
  },
];
---

<ManualLayout
  title="Audacity ® Manual | Getting started"
  description="New to Audacity? Nine short steps from installing it to exporting your first recording."
  stream="getting-started"
>
  <ManualLandingHeader
    stream="getting-started"
    title="Getting started"
    description="Never opened Audacity before? Follow these nine steps in order and you'll have recorded, edited and exported something by the end."
    count={pageCount}
    meta={["9 steps", "About twenty minutes"]}
  />

  {
    /*
    The fork at the front door: a 4.0 manual has two audiences, and the
    Audacity 3 veterans — likely the larger group at launch — need a
    translation layer, not a nine-step tutorial. One prominent side door
    beats a second parallel path.
  */
  }
  <a
    href="/manual/new-in-audacity-4/audacity-3-to-4-transition-guide"
    class="mb-8 flex items-center justify-between gap-4 rounded-lg border border-text-primary/10 bg-background-light p-4 transition-colors hover:border-accent hover:bg-accent/5"
  >
    <span class="block">
      <span class="block text-base font-semibold text-text-primary">
        Coming from Audacity 3?
      </span>
      <span class="mt-1 block text-sm text-text-primary/60">
        Skip the tutorial — the transition guide maps what moved, what changed
        and how to make Audacity 4 feel like home.
      </span>
    </span>
    <span aria-hidden="true" class="shrink-0 text-text-primary/40">&rarr;</span>
  </a>

  <ol class="space-y-3 mb-12 list-none pl-0">
    {
      steps.map((step) => (
        <li>
          {/* The whole card is the link — a title-only target is a small hit
              area for what is the primary action on this page. */}
          <a
            href={step.href}
            class="flex gap-4 rounded-lg border border-text-primary/10 p-4 transition-colors hover:border-accent hover:bg-accent/5"
          >
            <span
              aria-hidden="true"
              class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-background-medium text-sm font-semibold text-text-primary/80"
            >
              {step.number}
            </span>
            <span class="block">
              <span class="block text-base font-semibold text-text-primary">
                {step.title}
              </span>
              <span class="mt-1 block text-sm text-text-primary/60">
                {step.description}
              </span>
            </span>
          </a>
        </li>
      ))
    }
  </ol>
</ManualLayout>
