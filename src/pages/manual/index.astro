---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ManualSidebar from "../../components/manual/ManualSidebar.astro";
import ManualStreamCards from "../../components/manual/ManualStreamCards.astro";
---

<BaseLayout
  title="Audacity ® Manual"
  description="The official guide to Audacity 4. Search by keyword or click the UI to find what you need."
  showPromoBanner={false}
>
  <main id="main" class="max-w-screen-2xl mx-auto">
    <div class="grid grid-cols-12 gap-x-8 pt-8 pb-32">
      <aside
        class="col-start-2 col-span-10 sm:col-start-2 sm:col-span-3 sm:sticky sm:top-8 self-start"
      >
        <ManualSidebar currentSlug="" />
      </aside>

      <article
        class="col-start-2 col-span-10 sm:col-start-6 sm:col-span-6 xl:col-start-5 xl:col-span-6"
      >
        <header class="mb-8">
          <h1 class="text-4xl lg:text-5xl">Audacity Manual</h1>
          <p class="text-lg text-text-primary/60 mt-2">
            Guides, how-tos and the full reference for Audacity 4. Pick a
            section below, or search.
          </p>
        </header>

        <ManualStreamCards />
      </article>
    </div>
  </main>
</BaseLayout>
