---
import path from "node:path";
import { fileURLToPath } from "node:url";
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ManualSidebar from "../../components/manual/ManualSidebar.astro";
import ManualOnThisPage from "../../components/manual/ManualOnThisPage.astro";
import ManualPagination from "../../components/manual/ManualPagination.astro";
import BackToTop from "../../components/manual/BackToTop.astro";
import { getLastUpdated } from "../../utils/lastUpdated";

export async function getStaticPaths() {
  const entries = await getCollection("manual", ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

// Immediate children: slug starts with `${entry.slug}/` and has no further
// nesting beyond that. Used to render an in-page "Pages in this section"
// list on parent pages.
const allEntries = await getCollection(
  "manual",
  ({ data }) => !data.draft && data.stream === entry.data.stream,
);
const childPrefix = `${entry.id}/`;
const children = allEntries
  .filter((e) => {
    if (!e.id.startsWith(childPrefix)) return false;
    const remainder = e.id.slice(childPrefix.length);
    return remainder.length > 0 && !remainder.includes("/");
  })
  .sort((a, b) => {
    if (a.data.order !== b.data.order) return a.data.order - b.data.order;
    return a.id.localeCompare(b.id);
  });

const projectRoot = fileURLToPath(new URL("../../..", import.meta.url));
const entryPath = path.join(projectRoot, "src", "content", "manual", entry.id);
const lastUpdated = getLastUpdated(entryPath);
const lastUpdatedLabel = lastUpdated.toLocaleDateString("en-GB", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
const lastUpdatedISO = lastUpdated.toISOString();
---

<BaseLayout
  title={`Audacity ® Manual | ${entry.data.title}`}
  description={entry.data.description ?? entry.data.title}
  showPromoBanner={false}
>
  <main id="main" class="max-w-screen-2xl mx-auto">
    <div class="grid grid-cols-12 gap-x-8 pt-8 lg:pt-14 pb-32">
      <aside
        class="col-start-2 col-span-10 sm:col-start-2 sm:col-span-3 sm:sticky sm:top-8 self-start"
      >
        <ManualSidebar
          currentSlug={entry.id}
          currentStream={entry.data.stream}
        />
      </aside>
      <article
        {/*
          The ramp: 16 body, 16/18/24 h4/h3/h2 — one clear step per level,
          with the h1 (32/40) reserved for the page's identity alone. The old
          32px h2 shouted at the same volume as the title, so a page with
          three sections read as four titles. Space above a heading is
          roughly double the space below, so headings attach to what follows.

          prose-code: Typography's default dresses inline code in literal
          backtick pseudo-elements and bold 600 — `.dmg` rendered with its
          backticks showing. A quiet pill instead.
        */}
        class="col-start-2 col-span-10 sm:col-start-6 sm:col-span-6 xl:col-start-5 xl:col-span-6 max-w-none prose
          prose-p:text-16 prose-p:leading-relaxed prose-p:text-text-primary/80
          prose-li:text-16 prose-li:leading-relaxed prose-li:text-text-primary/80 prose-li:my-1.5
          prose-ul:my-5 prose-ol:my-5
          prose-h2:text-24 prose-h2:font-semibold prose-h2:leading-tight prose-h2:text-text-primary prose-h2:mt-12 prose-h2:mb-4
          prose-h3:text-18 prose-h3:font-semibold prose-h3:text-text-primary prose-h3:mt-8 prose-h3:mb-3
          prose-h4:text-16 prose-h4:font-semibold prose-h4:text-text-primary prose-h4:mt-6 prose-h4:mb-2
          prose-strong:text-text-primary prose-strong:font-semibold
          prose-a:text-accent prose-a:underline prose-a:underline-offset-4 prose-a:decoration-accent/40 hover:prose-a:decoration-accent
          prose-table:text-16 prose-th:text-text-primary prose-td:text-text-primary/80
          prose-code:text-14 prose-code:text-text-primary prose-code:font-medium prose-code:bg-background-light prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded
          prose-code:before:content-none prose-code:after:content-none
          prose-blockquote:text-text-primary/70 prose-blockquote:border-l-text-primary/20"
        data-pagefind-body
        data-pagefind-filter="type:Manual"
      >
        {
          /*
          The title gets its own block rather than sitting straight on top of
          the body copy: an eyebrow to say where you are, room to breathe under
          the heading, and a rule separating the page's identity from its
          content — the same job the banner does on the landings.
        */
        }
        <header class="not-prose mb-10 border-b border-text-primary/10 pb-8">
          <p
            class="text-12 font-semibold uppercase tracking-wider text-text-primary/50"
          >
            {entry.data.section}
          </p>
          <h1
            class="mt-3 text-32 lg:text-40 font-semibold leading-tight text-text-primary"
          >
            {entry.data.title}
          </h1>
          {
            entry.data.description && (
              <p class="mt-4 max-w-2xl text-18 text-text-primary/60">
                {entry.data.description}
              </p>
            )
          }
        </header>
        <Content />
        {
          children.length > 0 && (
            <ul class="not-prose mt-12 grid grid-cols-1 sm:grid-cols-2 gap-3">
              {children.map((child) => (
                <li>
                  <a
                    href={`/manual/${child.id}`}
                    class="block h-full p-4 rounded-lg border border-text-primary/10 hover:border-accent hover:bg-accent/5 transition-colors"
                  >
                    <span class="block font-semibold text-text-primary text-base">
                      {child.data.title}
                    </span>
                    {child.data.description && (
                      <span class="block text-sm text-text-primary/60 mt-1">
                        {child.data.description}
                      </span>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
        <ManualPagination
          currentSlug={entry.id}
          currentStream={entry.data.stream}
        />
        <p class="not-prose mt-8 text-xs text-text-primary/50">
          Last updated <time datetime={lastUpdatedISO}>{lastUpdatedLabel}</time>
        </p>
      </article>
      <aside
        class="hidden xl:block xl:col-start-11 xl:col-span-2 sticky top-20 self-start"
      >
        <ManualOnThisPage headings={headings} />
      </aside>
    </div>
  </main>
  <BackToTop />
</BaseLayout>

<style is:global>
  /* Offset anchor scrolling so headings clear the sticky site header (h-14). */
  main .prose :is(h2, h3, h4, h5, h6)[id] {
    scroll-margin-top: 5rem;
  }
</style>
