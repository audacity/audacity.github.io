---
import { getCollection } from "astro:content";
import ManualArticle from "../../components/manual/ManualArticle.astro";
import { streamMeta } from "../../components/manual/streams";

/*
  Every manual page. A standalone stream (the plugins directory) has its own
  route under its own base, so its entries are left out here; see
  pages/plugins/[...slug].astro. The template itself is shared: ManualArticle.
*/
export async function getStaticPaths() {
  const entries = await getCollection(
    "manual",
    ({ data }) => !data.draft && !streamMeta(data.stream).standalone,
  );
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
---

<ManualArticle entry={entry} />
