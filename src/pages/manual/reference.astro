---
import ManualLayout from "../../layouts/ManualLayout.astro";
import ManualLandingHeader from "../../components/manual/ManualLandingHeader.astro";
import { getCollection } from "astro:content";
import ProjectWindowExplorer from "../../components/manual/interactive/ProjectWindowExplorer.tsx";
import "@dilsonspickles/components/style.css";

/*
  Landing for the Reference stream.

  Reference is the one stream where "the first page" means nothing — it's a
  space to look things up in, not a path to follow. So the entry point is a
  map: click the interface, or browse the sections below.
*/

const pages = await getCollection(
  "manual",
  ({ data }) => !data.draft && data.stream === "reference",
);

const grouped = new Map<
  string,
  { sectionOrder: number; pages: typeof pages }
>();
for (const p of pages) {
  const g = grouped.get(p.data.section);
  if (g) g.pages.push(p);
  else
    grouped.set(p.data.section, {
      sectionOrder: p.data.sectionOrder,
      pages: [p],
    });
}
const sections = Array.from(grouped.entries())
  .sort((a, b) => a[1].sectionOrder - b[1].sectionOrder)
  .map(([name, { pages }]) => ({
    name,
    pages: pages.sort((a, b) => a.data.order - b.data.order),
  }));
---

<ManualLayout
  title="Audacity ® Manual | Reference"
  description="Every menu, toolbar and panel in Audacity 4, described in detail."
  stream="reference"
>
  <ManualLandingHeader
    stream="reference"
    title="Reference"
    description="What every part of Audacity 4 does. Click the interface below to jump straight to a control, or browse the sections."
    count={pages.length}
    meta={[
      `${sections.length} ${sections.length === 1 ? "section" : "sections"}`,
    ]}
  />

  <section aria-labelledby="window-heading" class="mb-12">
    <h2 id="window-heading" class="text-2xl">Click the interface</h2>
    <p class="mt-2 text-gray-700">
      The Audacity 4 window, recreated from its real components. Click any part
      of it to open the page that documents it.
    </p>
    {
      /* The window renders at its natural width: spill into the landing's
        empty right rail on wide screens, scroll horizontally below that. */
    }
    <div class="overflow-x-auto xl:w-[1000px] xl:max-w-none">
      <ProjectWindowExplorer client:load />
    </div>
  </section>

  {
    sections.map((section) => (
      <section class="mb-8">
        <h2 class="text-2xl">{section.name}</h2>
        <ul class="mt-3 space-y-2">
          {section.pages.map((p) => (
            <li>
              <a href={`/manual/${p.id}`} class="hover:text-blue-700">
                {p.data.title}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</ManualLayout>
