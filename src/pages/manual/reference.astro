---
import ManualLayout from "../../layouts/ManualLayout.astro";
import { getCollection } from "astro:content";
import UIMap from "../../components/manual/UIMap.jsx";
import ManualToolbarDemo from "../../components/manual/Toolbar/ManualToolbarDemo.jsx";
import "@dilsonspickles/components/style.css";
import projectWindow from "../../assets/img/manual/Manual-UI.webp";

/*
  Landing for the Reference stream.

  Reference is the one stream where "the first page" means nothing — it's a
  space to look things up in, not a path to follow. So the entry point is a
  map: click the interface, or browse the sections below.
*/
const projectHotspots: Array<{
  n: number;
  label: string;
  x: number;
  y: number;
  w: number;
  h: number;
  href: string;
}> = [
  {
    n: 1,
    label: "Project toolbar",
    x: 0,
    y: 3,
    w: 100,
    h: 4,
    href: "/manual/interface/project-toolbar",
  },
  {
    n: 2,
    label: "Tools toolbar",
    x: 0,
    y: 7,
    w: 100,
    h: 5,
    href: "/manual/interface/tools-toolbar",
  },
];

const pages = await getCollection(
  "manual",
  ({ data }) => !data.draft && data.stream === "reference",
);

const grouped = new Map<
  string,
  { sectionOrder: number; pages: typeof pages }
>();
for (const p of pages) {
  const g = grouped.get(p.data.section);
  if (g) g.pages.push(p);
  else
    grouped.set(p.data.section, {
      sectionOrder: p.data.sectionOrder,
      pages: [p],
    });
}
const sections = Array.from(grouped.entries())
  .sort((a, b) => a[1].sectionOrder - b[1].sectionOrder)
  .map(([name, { pages }]) => ({
    name,
    pages: pages.sort((a, b) => a.data.order - b.data.order),
  }));
---

<ManualLayout
  title="Audacity ® Manual | Reference"
  description="Every menu, toolbar and panel in Audacity 4, described in detail."
  stream="reference"
>
  <header class="mb-8">
    <h1 class="text-4xl lg:text-5xl">Reference</h1>
    <p class="text-lg text-gray-600 mt-2">
      What every part of Audacity 4 does. Click the interface below to jump
      straight to a control, or browse the sections.
    </p>
  </header>

  <section aria-labelledby="toolbar-heading" class="mb-12">
    <h2 id="toolbar-heading" class="text-2xl">Click an interface</h2>
    <p class="mt-2 text-gray-700">
      The Audacity 4 toolbar, recreated. Click a button to jump to its manual
      page.
    </p>
    <div class="mt-6 border border-gray-200 rounded-lg overflow-hidden">
      <ManualToolbarDemo client:load />
    </div>
  </section>

  <section aria-labelledby="map-heading" class="mb-12">
    <h2 id="map-heading" class="text-2xl">Find it on the screen</h2>
    <p class="mt-2 text-gray-700">
      Hover or focus a number, then click to read about that part of the
      Audacity 4 project window.
    </p>
    <UIMap
      client:load
      src={projectWindow}
      alt="Audacity 4 project window map"
      hotspots={projectHotspots}
    />
  </section>

  {
    sections.map((section) => (
      <section class="mb-8">
        <h2 class="text-2xl">{section.name}</h2>
        <ul class="mt-3 space-y-2">
          {section.pages.map((p) => (
            <li>
              <a href={`/manual/${p.slug}`} class="hover:text-blue-700">
                {p.data.title}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</ManualLayout>
