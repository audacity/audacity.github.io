---
import ManualLayout from "../../layouts/ManualLayout.astro";
import ManualLandingHeader from "../../components/manual/ManualLandingHeader.astro";
import { getCollection } from "astro:content";

/*
  Landing for the Reference stream.

  Reference is the one stream where "the first page" means nothing — it's a
  space to look things up in, not a path to follow. So the entry point is a
  directory: every section as a card, every page one click away.

  An earlier version opened with a clickable render of the app window
  (ProjectWindowMap). Shelved for launch — replicating the old manual's
  interactive UI image fought the layout at narrow widths — but the
  component is still in the repo if it earns its way back.
*/

const pages = await getCollection(
  "manual",
  ({ data }) => !data.draft && data.stream === "reference",
);

const grouped = new Map<
  string,
  { sectionOrder: number; pages: typeof pages }
>();
for (const p of pages) {
  const g = grouped.get(p.data.section);
  if (g) g.pages.push(p);
  else
    grouped.set(p.data.section, {
      sectionOrder: p.data.sectionOrder,
      pages: [p],
    });
}
const sections = Array.from(grouped.entries())
  .sort((a, b) => a[1].sectionOrder - b[1].sectionOrder)
  .map(([name, { pages }]) => ({
    name,
    pages: pages.sort((a, b) => a.data.order - b.data.order),
  }));

/*
  Two-column packing done here rather than with CSS columns: Safari
  balances multicol differently from Firefox and the cards ended up
  ragged. Cards are collapsed accordions of uniform height, so a
  simple half-and-half split keeps the columns level in every browser
  while reading order stays top-to-bottom, left then right.
*/
const mid = Math.ceil(sections.length / 2);
const columns = [sections.slice(0, mid), sections.slice(mid)];
---

<ManualLayout
  title="Audacity ® Manual | Reference"
  description="Every menu, toolbar and panel in Audacity 4, described in detail."
  stream="reference"
>
  <ManualLandingHeader
    stream="reference"
    title="Reference"
    description="What every part of Audacity 4 does, organised by where it lives in the app."
    count={pages.length}
    meta={[
      `${sections.length} ${sections.length === 1 ? "section" : "sections"}`,
    ]}
  />

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 items-start">
    {
      columns.map((column) => (
        <div class="flex flex-col gap-5">
          {column.map((section) => (
            <a
              href={`/manual/${section.pages[0].id}`}
              class="group flex items-baseline gap-3 rounded-lg border border-text-primary/10 bg-background-light p-5 transition-colors hover:border-accent hover:bg-accent/5"
            >
              <h2 class="text-18 font-semibold leading-tight text-text-primary transition-colors group-hover:text-accent">
                {section.name}
              </h2>
              <span class="text-14 text-text-primary/50">
                {section.pages.length} pages
              </span>
              <span class="ml-auto text-text-primary/40" aria-hidden="true">
                →
              </span>
            </a>
          ))}
        </div>
      ))
    }
  </div>
</ManualLayout>
