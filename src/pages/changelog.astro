---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/icons.css";
import { audacityReleases } from "../assets/data/audacityReleases";
import { changelog } from "../assets/data/changelog";

const current = audacityReleases.version;

/*
  Moved here from the old support hub, where it had fallen two releases
  behind the version the download pages were offering. Generated from the
  release notes now, so it can't drift from what actually shipped.

  Each release has its own page under /changelog/<version>/ — this index
  is the directory. The old single-page accordion grew past 38 releases,
  and a deep link into 2,000 lines of collapsed rows served nobody.

  Not under /download/: everything else in that namespace hands you a
  binary, and the people who want this are as often updating an existing
  install as choosing one to download.
*/
const fmt = (iso: string) =>
  new Date(iso + "T00:00:00Z").toLocaleDateString("en-GB", {
    day: "numeric",
    month: "short",
    year: "numeric",
    timeZone: "UTC",
  });

const versions = changelog.map((e) => e.version);
---

<BaseLayout
  title="Changelog | Audacity"
  description="What changed in each release of Audacity, from 3.0.0 onwards."
  canonical="https://www.audacityteam.org/changelog/"
>
  <main id="main">
    <section class="bg-background-medium border-b border-text-primary/10">
      <div
        class="mx-auto max-w-screen-lg px-6 xs:px-12 md:px-8 py-8 md:py-10 flex flex-col gap-3"
      >
        <h1
          class="font-harmony text-40 md:text-56 text-text-primary leading-tight"
        >
          Changelog
        </h1>
        <p class="text-18 text-text-primary/60 max-w-2xl">
          What changed in each release of Audacity, newest first. Every release
          from 3.0.0 onwards is here.
        </p>
      </div>
    </section>

    <div
      class="mx-auto max-w-screen-lg px-6 xs:px-12 md:px-8 py-10 md:py-14 flex flex-col gap-10"
    >
      <section class="flex flex-col gap-4">
        <h2
          class="text-12 uppercase tracking-wider font-semibold text-text-primary/50"
        >
          {changelog.length} releases
        </h2>

        <ul
          class="release-list divide-y divide-text-primary/10 overflow-hidden rounded-xl border border-text-primary/15 bg-white"
        >
          {
            changelog.map((entry) => (
              <li>
                <a
                  href={`/changelog/${entry.version}/`}
                  class="flex items-center gap-3 px-5 py-4 transition-colors hover:bg-accent/5"
                >
                  <span class="text-18 font-semibold text-text-primary">
                    {entry.version}
                  </span>
                  {entry.version === current && (
                    <span class="rounded-full bg-accent/10 px-2 py-0.5 text-12 font-semibold text-accent">
                      Current
                    </span>
                  )}
                  <span class="ml-auto text-14 tabular-nums text-text-primary/50">
                    {fmt(entry.date)}
                  </span>
                  <span
                    class="icon icon-medium icon-caret-right shrink-0 text-text-primary/40"
                    aria-hidden="true"
                  />
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <section
        class="rounded-xl border border-text-primary/10 bg-background-medium p-6 flex flex-col gap-2"
      >
        <h2 class="text-18 font-semibold text-text-primary">
          Looking for one of these builds?
        </h2>
        <p class="text-16 text-text-primary/70 max-w-2xl">
          Installers for every release listed here, along with the offline
          manual that shipped with each one, are available from this site.
        </p>
        <a
          href="/download/older-versions"
          class="w-fit font-semibold text-accent hover:underline underline-offset-4"
        >
          Browse older versions
        </a>
      </section>
    </div>
  </main>
</BaseLayout>

<script define:vars={{ versions }}>
  /*
    Deep links like /changelog#3.6.0 are how the blog posts and release
    announcements have always pointed at a specific version. The notes now
    live on their own pages, so an arriving hash forwards there — replace,
    not assign, so Back doesn't bounce through the index. Hashes that
    don't name a release (or #main from the skip link) stay put.
  */
  const forward = () => {
    const id = decodeURIComponent(location.hash.slice(1));
    if (id && versions.includes(id)) {
      location.replace(`/changelog/${id}/`);
    }
  };
  forward();
  window.addEventListener("hashchange", forward);
</script>
