---
import BaseLayout from "../../layouts/BaseLayout.astro";

/*
  The translating guide. Content restored from audacity-support
  (community/contributing/translating.md) after the support GitBook's
  restructure 404'd its hosted copy; this page is the live home, and
  /contribute#translate plus the /community/translators/ shortlink land
  here.

  Merged from two parallel efforts (9-10 Sep 2026): Teetow's
  feat/translating-page branch supplied the freshly captured media
  (webm+mp4 sources, 1440x900 screenshots), the figure semantics and the
  video aria-labels; the hub styling and wiring come from the page that
  had already shipped. The Discord link stays the translator-specific
  invite from the original guide, per Alex.
*/

const pageTitle = "Audacity ® | Translating Audacity";
const pageDescription =
  "How to translate Audacity into your language using Transifex.";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  showPromoBanner={false}
>
  <main id="main">
    <section class="bg-background-deep">
      <div class="max-w-screen-lg mx-auto px-6 xs:px-12 md:px-8 py-12 md:py-16">
        <div class="flex flex-col gap-4">
          <h1
            class="font-harmony text-40 md:text-48 text-text-contrast leading-tight"
          >
            Translating Audacity
          </h1>
          <p class="text-18 text-text-contrast/70 max-w-2xl">
            Audacity is translated into many languages by volunteers. It is a
            way to contribute right in Audacity's interface, without writing any
            code.
          </p>
        </div>
      </div>
    </section>

    <div
      class="max-w-screen-lg mx-auto px-6 xs:px-12 md:px-8 py-12 md:py-16 flex flex-col gap-10"
    >
      <section class="flex flex-col gap-4">
        <h2 class="font-harmony text-28 md:text-32 text-text-primary">
          Join the project on Transifex
        </h2>
        <p class="text-16 md:text-18 text-text-primary/80">
          Translation happens on Transifex. Find the Audacity project at
          <a
            href="https://explore.transifex.com/audacity/audacity/"
            class="text-accent underline underline-offset-4 decoration-accent/40 hover:decoration-accent transition-colors"
            target="_blank"
            rel="noopener">explore.transifex.com/audacity/audacity</a
          > and:
        </p>
        <ol
          class="list-decimal pl-5 flex flex-col gap-2 text-16 md:text-18 text-text-primary/80 marker:text-text-primary/40"
        >
          <li>
            Click the <strong>Join this project</strong> button on the right side.
          </li>
          <li>
            Select the language you would like to contribute to from the
            dropdown.
          </li>
          <li>
            Click <strong>Join project</strong> if the language is available to join,
            or <strong>Request language</strong> if it is not listed yet.
          </li>
        </ol>
        <figure class="flex flex-col gap-2">
          <video
            width="1440"
            height="900"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            aria-label="The Audacity project page on Transifex Explore: the JOIN THIS PROJECT button on the right, then the language dropdown, then Join Project"
            class="w-full h-auto rounded-lg border border-text-primary/15"
          >
            <source
              src="/contribute/translating/join-project.webm"
              type="video/webm"
            />
            <source
              src="/contribute/translating/join-project.mp4"
              type="video/mp4"
            />
          </video>
          <figcaption class="text-14 text-text-primary/60">
            Select the language you want to translate Audacity to, then join or
            request it.
          </figcaption>
        </figure>
        <p class="text-16 md:text-18 text-text-primary/80">
          Once you are approved as a translator you receive an email
          notification. The project then appears in your Transifex dashboard and
          you can start contributing.
        </p>
        <figure class="flex flex-col gap-2">
          <img
            src="/contribute/translating/transifex-dashboard.png"
            alt="The Audacity project dashboard in Transifex, showing source string and word counts, localization activity, per-language progress, and the Translate button at the top right"
            width="1441"
            height="901"
            loading="lazy"
            decoding="async"
            class="w-full h-auto rounded-lg border border-text-primary/15"
          />
          <figcaption class="text-14 text-text-primary/60">
            The Audacity project dashboard in Transifex.
          </figcaption>
        </figure>
      </section>

      <section class="flex flex-col gap-4">
        <h2 class="font-harmony text-28 md:text-32 text-text-primary">
          Translate strings
        </h2>
        <ol
          class="list-decimal pl-5 flex flex-col gap-2 text-16 md:text-18 text-text-primary/80 marker:text-text-primary/40"
        >
          <li>Click <strong>Translate</strong> at the top right.</li>
          <li>
            Select <strong>Audacity</strong> from the resource overview to start editing.
          </li>
          <li>
            Select a string and type the corresponding translation in your
            language.
          </li>
          <li>
            Click <strong>Save translation</strong> and move to the next string.
          </li>
        </ol>
        <figure class="flex flex-col gap-2">
          <video
            width="1440"
            height="900"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            aria-label="The Transifex editor with the Audacity resource open: selecting a string, typing the translation, and saving it"
            class="w-full h-auto rounded-lg border border-text-primary/15"
          >
            <source
              src="/contribute/translating/transifex-editor.webm"
              type="video/webm"
            />
            <source
              src="/contribute/translating/transifex-editor.mp4"
              type="video/mp4"
            />
          </video>
          <figcaption class="text-14 text-text-primary/60">
            The Transifex editor, translating strings one by one.
          </figcaption>
        </figure>
        <p class="text-16 md:text-18 text-text-primary/80">
          The editor has keyboard shortcuts that speed the workflow up, listed
          under its overflow menu. The most useful is
          <strong>Tab</strong>, which saves the current string and moves
          straight to the next one.
        </p>
        <img
          src="/contribute/translating/transifex-shortcuts-menu.png"
          alt="The Transifex editor's overflow menu, open on Editor Preferences, Show source string in English, and Keyboard Shortcuts"
          width="407"
          height="169"
          loading="lazy"
          decoding="async"
          class="h-auto max-w-full rounded-lg border border-text-primary/15"
        />
      </section>

      <section class="flex flex-col gap-4">
        <h2 class="font-harmony text-28 md:text-32 text-text-primary">
          Join the translator community
        </h2>
        <p class="text-16 md:text-18 text-text-primary/80">
          Questions, and notice of upcoming releases that need translation, live
          in two places:
        </p>
        <ul
          class="list-disc pl-5 flex flex-col gap-2 text-16 md:text-18 text-text-primary/80 marker:text-text-primary/40"
        >
          <li>
            <a
              href="https://discord.gg/UvNH4cFjVP"
              class="text-accent underline underline-offset-4 decoration-accent/40 hover:decoration-accent transition-colors"
              target="_blank"
              rel="noopener">The translator channel on Discord</a
            >
          </li>
          <li>
            <a
              href="https://sourceforge.net/projects/audacity/lists/audacity-translation"
              class="text-accent underline underline-offset-4 decoration-accent/40 hover:decoration-accent transition-colors"
              target="_blank"
              rel="noopener">The audacity-translation mailing list</a
            >
          </li>
        </ul>
        <p class="text-16 md:text-18 text-text-primary/80">
          And that's it. Happy translating!
        </p>
      </section>
    </div>
  </main>
</BaseLayout>
