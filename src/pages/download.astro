---
import BaseLayout from "../layouts/BaseLayout.astro";
import OperatingSystemCard from "../components/card/OperatingSystemCard";
import "../styles/icons.css";
import {
  audacityReleases,
  hasDownloadAssets,
  preReleaseList,
  type PreReleaseEntry,
} from "../assets/data/audacityReleases";
import { useTranslations } from "../i18n";

const { version } = audacityReleases;
const sourceDownloads = audacityReleases.src ?? [];
const primarySourceDownload = sourceDownloads[0] ?? null;
const activeDownloadEntries = preReleaseList.filter(
  (entry) => entry.isActive && hasDownloadAssets(entry.downloads),
);
const hasDownloadCampaigns = activeDownloadEntries.length > 0;
const t = useTranslations(Astro.currentLocale);

const formatCampaignLinkLabel = (
  entry: PreReleaseEntry,
  platform: string,
  buildName?: string,
) =>
  `${entry.downloads.version} for ${platform}${
    buildName ? ` (${buildName})` : ""
  }`;
---

<BaseLayout
  title="Audacity ® | Downloads"
  description="Download Audacity for Windows, macOS and Linux"
>
  <main id="main" class="download-page flex-1 flex flex-col">
    <!-- Page head. No dark band: this is a transactional page, and the
         downloads themselves should be the first thing reached. -->
    <section>
      <div
        class="max-w-screen-lg mx-auto px-6 xs:px-12 md:px-8 pt-10 md:pt-12 flex flex-col gap-5"
      >
        <div class="flex flex-col gap-3">
          <h1
            class="font-harmony text-40 md:text-48 text-text-primary leading-tight"
          >
            {t("download.title")}
          </h1>
          <p class="text-16 text-text-primary/60">
            {t("download.currentVersion")}
            <span class="text-text-primary">{version}</span>
            <span class="px-2 text-text-primary/30">|</span>
            <a
              class="text-text-primary underline underline-offset-4 decoration-text-primary/40 hover:text-accent hover:decoration-accent transition-colors"
              href="/changelog">{t("download.viewChangelog")}</a
            >
          </p>
        </div>
      </div>
    </section>

    <div
      class="max-w-screen-lg mx-auto w-full px-6 xs:px-12 md:px-8 pt-8 pb-12 md:pb-16 flex flex-col gap-12 md:gap-16"
    >
      <section>
        <h2
          class="text-12 uppercase tracking-wider font-semibold text-text-primary/50"
        >
          {t("download.downloadFor")}
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-4">
          <OperatingSystemCard
            title="Windows"
            description="Intel: 32 & 64 bit, ARM64 (beta)"
            targetURL="/download/windows"
          />
          <OperatingSystemCard
            title="macOS"
            description="Universal Binary"
            targetURL="/download/mac"
          />
          <OperatingSystemCard
            title="Linux"
            description="64 bit appimage"
            targetURL="/download/linux"
          />
        </div>
      </section>
      <aside>
        {
          hasDownloadCampaigns && (
            <div>
              <h2 class="text-12 uppercase tracking-wider font-semibold text-text-primary/50">
                {t("download.preRelease")}
              </h2>
              <div class="flex flex-col gap-6 mt-2">
                {activeDownloadEntries.map((entry) => {
                  const downloads = entry.downloads;
                  const windowsBuilds = downloads.win ?? [];
                  const macBuilds = downloads.mac ?? [];
                  const linuxBuilds = downloads.lin ?? [];
                  const versionLabel = downloads.version;

                  return (
                    <div class="flex flex-col gap-3">
                      <h3 class="text-18 font-semibold text-text-primary">
                        {versionLabel}
                      </h3>
                      <p class="text-16 text-text-primary/60">
                        {entry.summary}
                      </p>
                      <ul class="flex flex-col gap-2 text-sm">
                        {windowsBuilds.map((build) => (
                          <li>
                            <a
                              class="hyperlink"
                              href={build.browser_download_url}
                            >
                              {formatCampaignLinkLabel(
                                entry,
                                "Windows",
                                build.name,
                              )}
                            </a>
                          </li>
                        ))}
                        {macBuilds.map((build) => (
                          <li>
                            <a
                              class="hyperlink"
                              href={build.browser_download_url}
                            >
                              {formatCampaignLinkLabel(
                                entry,
                                "macOS",
                                build.name,
                              )}
                            </a>
                          </li>
                        ))}
                        {linuxBuilds.map((build) => (
                          <li>
                            <a
                              class="hyperlink"
                              href={build.browser_download_url}
                            >
                              {formatCampaignLinkLabel(
                                entry,
                                "Linux",
                                build.name,
                              )}
                            </a>
                          </li>
                        ))}
                      </ul>
                      <div class="flex items-center gap-1">
                        <a href={entry.pageHref} class="hyperlink text-sm">
                          {`Learn more about ${versionLabel}`}
                        </a>
                        <span class="align-middle icon icon-share text-blue-600" />
                      </div>
                    </div>
                  );
                })}
              </div>
            </div>
          )
        }
        <h2
          class="text-12 uppercase tracking-wider font-semibold text-text-primary/50"
        >
          {t("download.additionalResources")}
        </h2>
        {
          /*
            items-start: without it the grid stretches every card to the
            tallest row, so expanding the checksum disclosure inflated the
            three link cards with empty space.
          */
        }
        <div
          class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mt-4 items-start"
        >
          {
            /*
            Same card language as the OS choices above. Previously these were
            bare .hyperlink anchors — accent-coloured underlined text, which
            reads as an error — each trailed by a loose icon span that wrapped
            onto its own line.
          */
          }
          <a
            href="https://github.com/audacity/audacity-manual/releases"
            target="_blank"
            rel="noopener"
            class="group flex flex-col gap-1 rounded-xl border border-text-primary/15 bg-white p-5 transition-colors hover:border-accent hover:bg-accent/5"
          >
            <span
              class="text-16 font-semibold text-text-primary transition-colors group-hover:text-accent"
              >{t("download.offlineManual")}</span
            >
            <span class="text-14 text-text-primary/60"
              >{t("download.downloadManual")}</span
            >
            <span
              class="mt-auto pt-3 inline-flex items-center gap-1.5 text-14 font-semibold text-accent"
            >
              Open<span class="icon icon-share" aria-hidden="true"></span>
            </span>
          </a>

          <a
            href="https://support.audacityteam.org/basics/installing-ffmpeg"
            target="_blank"
            rel="noopener"
            class="group flex flex-col gap-1 rounded-xl border border-text-primary/15 bg-white p-5 transition-colors hover:border-accent hover:bg-accent/5"
          >
            <span
              class="text-16 font-semibold text-text-primary transition-colors group-hover:text-accent"
              >{t("download.ffmpeg")}</span
            >
            <span class="text-14 text-text-primary/60"
              >{t("download.ffmpegDesc")}</span
            >
            <span
              class="mt-auto pt-3 inline-flex items-center gap-1.5 text-14 font-semibold text-accent"
            >
              Open<span class="icon icon-share" aria-hidden="true"></span>
            </span>
          </a>

          {
            /*
            A plain link like its neighbours. The checksum was disclosed here,
            but it only ever covered the source tarball — every binary's own
            checksum already sits beside it on the per-platform pages, via
            DownloadPageLayout's DownloadCard, which is where someone about to
            download that file will look.
          */
          }
          <a
            href={primarySourceDownload
              ? primarySourceDownload.browser_download_url
              : "https://github.com/audacity/audacity/releases"}
            target="_blank"
            rel="noopener"
            class="group flex flex-col gap-1 rounded-xl border border-text-primary/15 bg-white p-5 transition-colors hover:border-accent hover:bg-accent/5"
          >
            <span
              class="text-16 font-semibold text-text-primary transition-colors group-hover:text-accent"
              >{t("download.sourceCode")}</span
            >
            <span class="text-14 text-text-primary/60">
              {
                primarySourceDownload
                  ? `Build Audacity yourself (${primarySourceDownload.type})`
                  : "Build Audacity yourself"
              }
            </span>
            <span
              class="mt-auto pt-3 inline-flex items-center gap-1.5 text-14 font-semibold text-accent"
            >
              Open<span class="icon icon-share" aria-hidden="true"></span>
            </span>
          </a>

          <a
            href="/download/older-versions"
            class="group flex flex-col gap-1 rounded-xl border border-text-primary/15 bg-white p-5 transition-colors hover:border-accent hover:bg-accent/5"
          >
            <span
              class="text-16 font-semibold text-text-primary transition-colors group-hover:text-accent"
              >{t("download.olderVersions")}</span
            >
            <span class="text-14 text-text-primary/60"
              >{t("download.olderVersionsBrowse")}</span
            >
            <span
              class="mt-auto pt-3 inline-flex items-center gap-1.5 text-14 font-semibold text-accent"
            >
              Browse
            </span>
          </a>
        </div>
      </aside>
    </div>
  </main>
</BaseLayout>

<style is:global>
  .download-page [data-recommended="true"] {
    border-color: #ff3254;
    box-shadow: 0 0 0 1px #ff3254;
  }
  .download-page [data-recommended="true"] .os-cue {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 2.75rem;
    border-radius: 9999px;
    background: #ff3254;
    color: #fff;
    padding: 0 1.25rem;
  }
</style>

<script is:inline>
  /*
    Promotes the card for the visitor's platform instead of adding a second
    download button beside it: one primary action, sitting where people
    already look to choose a platform. Runs only on a confident match —
    anything else leaves three equal choices, the honest default on the
    site's busiest page.

    Deliberately not React: this is two DOM writes and shouldn't cost an
    island on the hottest page.
  */
  (function () {
    var ua = navigator.userAgent;
    var os = null;
    if (/Windows/i.test(ua)) os = { key: "Windows", href: "/download/windows" };
    else if (/Mac OS X|Macintosh/i.test(ua))
      os = { key: "macOS", href: "/download/mac" };
    else if (/Linux|Ubuntu|Debian|Fedora/i.test(ua) && !/Android/i.test(ua))
      os = { key: "Linux", href: "/download/linux" };
    if (!os) return;

    var card = document.querySelector('[data-os-card="' + os.key + '"]');
    if (!card) return;
    var badge = card.querySelector("[data-os-badge]");
    if (badge) badge.hidden = false;
    card.setAttribute("data-recommended", "true");
    var cue = card.querySelector("[data-os-cue]");
    if (cue) cue.textContent = "Download for " + os.key;
  })();
</script>
