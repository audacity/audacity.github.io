---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { features } from "../../assets/data/features";
import "../../styles/icons.css";
---

<BaseLayout
  title="Features – Audacity"
  description="Explore Audacity's audio editing features. Learn how to pitch shift, record, mix, and more with free open-source software for Windows, Mac & Linux."
  canonical="https://www.audacityteam.org/features/"
>
  <main id="main">
    {
      /*
      Was a from-indigo-900 to-blue-700 gradient — a palette of its own, and
      the only page on the site opening on blue. Deep purple and the display
      face, matching /help, /search and /download.
    */
    }
    <section class="bg-background-deep">
      <div
        class="max-w-screen-lg mx-auto px-6 xs:px-12 md:px-8 py-12 md:py-16 flex flex-col gap-4"
      >
        <h1
          class="font-harmony text-40 md:text-48 text-text-contrast leading-tight"
        >
          Audacity Features
        </h1>
        <p class="text-18 text-text-contrast/70 max-w-2xl">
          Learn how to get the most out of Audacity with step-by-step guides for
          every feature.
        </p>
      </div>
    </section>

    <section
      class="max-w-screen-lg mx-auto px-6 xs:px-12 md:px-8 py-12 md:py-16"
    >
      <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {
          features.map((feature) => (
            <li>
              <a
                href={`/features/${feature.slug}/`}
                class="group flex h-full flex-col gap-2 rounded-xl border border-text-primary/15 bg-white p-6 transition-colors hover:border-accent hover:bg-accent/5"
              >
                <span
                  class={`icon icon-medium text-accent ${feature.icon}`}
                  aria-hidden="true"
                />
                <span class="text-20 font-semibold text-text-primary transition-colors group-hover:text-accent">
                  {feature.shortTitle}
                </span>
                <span class="text-16 text-text-primary/60">
                  {feature.description}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
</BaseLayout>
