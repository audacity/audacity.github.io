---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getStreamEntryPoints } from "../components/manual/streamEntries";
import HelpSearch from "../components/help/HelpSearch.astro";
import ForumSVG from "../components/inlineSVG/ForumSVG";
import DiscordSVG from "../components/inlineSVG/DiscordSVG";
import GithubSVG from "../components/inlineSVG/GithubSVG";

const pageTitle = "Audacity ® | Help";
const pageDescription =
  "Find Audacity guides, the manual, community support, and other resources.";

interface HelpEntry {
  title: string;
  description: string;
  href: string;
  external?: boolean;
  /* Rendered statically — these are pure SVG, so no client directive. */
  icon: (props: { className?: string }) => any;
}

/*
  The stream rows come straight from getStreamEntryPoints(): label, blurb, page
  count and the href of that stream's first published page. The page used to
  hardcode its own descriptions and throw the count away, which meant the hub
  and the manual could drift apart in wording and neither showed how much was
  actually written.

  A stream with nothing published yet has no entry point, so it renders as
  coming-soon rather than linking nowhere.
*/
const streams = await getStreamEntryPoints();

const community: HelpEntry[] = [
  {
    title: "Audacity Forum",
    icon: ForumSVG,
    description: "Community discussion, troubleshooting, and feature talk.",
    href: "https://forum.audacityteam.org/",
    external: true,
  },
  {
    title: "Audacity Discord",
    icon: DiscordSVG,
    description: "Live chat with users, contributors, and the team.",
    href: "https://discord.gg/audacity",
    external: true,
  },
  {
    title: "GitHub issues",
    icon: GithubSVG,
    description: "Report a bug or request a feature on the Audacity repo.",
    href: "https://github.com/audacity/audacity/issues",
    external: true,
  },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  showPromoBanner={false}
>
  <main id="main" class="help-page">
    <!-- Search band -->
    <section class="bg-background-deep">
      <div class="max-w-screen-lg mx-auto px-6 xs:px-12 md:px-8 py-12 md:py-16">
        <div class="flex flex-col gap-4">
          <h1
            class="font-harmony text-40 md:text-48 text-text-contrast leading-tight"
          >
            Help
          </h1>
          <p class="text-18 text-text-contrast/70 max-w-2xl">
            Search the manual, guides, FAQ and feature pages — or pick a
            starting point below.
          </p>
          <HelpSearch />
        </div>
      </div>
    </section>

    <div
      class="max-w-screen-lg mx-auto px-6 xs:px-12 md:px-8 py-12 md:py-16 flex flex-col gap-14"
    >
      <!-- Documentation streams -->
      <section aria-labelledby="help-docs" class="flex flex-col gap-6">
        <h2
          id="help-docs"
          class="font-harmony text-32 md:text-40 text-text-primary"
        >
          Guides &amp; reference
        </h2>

        <ul class="flex flex-col gap-3">
          {
            streams.map((stream) => (
              <li>
                {stream.href ? (
                  <a
                    href={stream.href}
                    class="group flex items-center gap-5 p-5 rounded-lg border border-text-primary/15 hover:border-accent hover:bg-accent/5 transition-colors"
                  >
                    <span class="flex flex-col gap-1 flex-1">
                      <span class="text-20 font-semibold text-text-primary group-hover:text-accent transition-colors">
                        {stream.label}
                      </span>
                      <span class="text-16 text-text-primary/60">
                        {stream.blurb}
                      </span>
                    </span>
                    <span class="shrink-0 text-14 font-semibold text-text-primary/50 tabular-nums">
                      {stream.count} {stream.count === 1 ? "page" : "pages"}
                    </span>
                  </a>
                ) : (
                  <div class="flex items-center gap-5 p-5 rounded-lg border border-dashed border-text-primary/15">
                    <span class="flex flex-col gap-1 flex-1">
                      <span class="text-20 font-semibold text-text-primary/50">
                        {stream.label}
                      </span>
                      <span class="text-16 text-text-primary/40">
                        {stream.blurb}
                      </span>
                    </span>
                    <span class="shrink-0 text-14 font-semibold text-text-primary/40">
                      Coming soon
                    </span>
                  </div>
                )}
              </li>
            ))
          }
          <li>
            <a
              href="/FAQ"
              class="group flex items-center gap-5 p-5 rounded-lg border border-text-primary/15 hover:border-accent hover:bg-accent/5 transition-colors"
            >
              <span class="flex flex-col gap-1 flex-1">
                <span
                  class="text-20 font-semibold text-text-primary group-hover:text-accent transition-colors"
                >
                  FAQ
                </span>
                <span class="text-16 text-text-primary/60">
                  Quick answers to the most common questions about Audacity.
                </span>
              </span>
            </a>
          </li>
        </ul>
      </section>

      <!-- Community -->
      <section aria-labelledby="help-community" class="flex flex-col gap-6">
        <h2
          id="help-community"
          class="font-harmony text-32 md:text-40 text-text-primary"
        >
          Community &amp; support
        </h2>
        <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {
            community.map((item) => (
              <li>
                <a
                  href={item.href}
                  target={item.external ? "_blank" : undefined}
                  rel={item.external ? "noopener" : undefined}
                  class="group block h-full p-5 rounded-lg border border-text-primary/15 hover:border-accent hover:bg-accent/5 transition-colors"
                >
                  <p class="flex items-center gap-2.5 text-18 font-semibold text-text-primary group-hover:text-accent transition-colors">
                    {/*
                      Solid black, and not following the card's hover:
                      Discord and GitHub both specify their marks in their
                      own colour, black or white, and neither permits a
                      recolour into another brand's palette. The forum's
                      bubble is ours but matches so the row stays even.
                    */}
                    <item.icon className="h-5 w-5 shrink-0 fill-black" />
                    {item.title}
                  </p>
                  <p class="text-16 text-text-primary/60 mt-2">
                    {item.description}
                  </p>
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </main>
</BaseLayout>

<style is:global>
  /*
    Match /audacity-4's footer treatment: that page drops the footer's own
    backdrop so it continues its closing section rather than butting
    against it. The hub ends on a light surface, so the same colour reads
    here as a deliberate base rather than a seam.

    Scoped to this page, the same way about.astro scopes its own override.
    The value is duplicated from about.astro — worth promoting to a theme
    token if a third page needs it.
  */
  body:has(.help-page) footer.bg-background-deep {
    background-color: rgb(8, 6, 28);
  }
</style>
