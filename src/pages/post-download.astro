---
import BaseLayout from "../layouts/BaseLayout.astro";
import JoinAudioDotComButton from "../components/button/JoinAudioDotComButton";
import "../styles/icons.css";
import AppMarks from "../components/post-download/AppMarks.astro";

/*
  Kept from main across the release-branch merge. The snippet is the
  AI-Experimentor host; the badges are the winning post-download variant from
  CRO experiment 805325524, so they're validated copy rather than decoration.
  The redesign around them is ours; only the greens they arrived in are gone,
  since the palette has no green.
*/
const AIX_HOST = "https://web-n7vh.onrender.com";
const badges = ["Free Cloud Storage", "Automatic Backups", "Access Anywhere"];

const steps = [
  { label: "Download Audacity application", done: true },
  { label: "Connect to Cloud storage", done: false },
  { label: "Never lose your work in Audacity", done: false },
];
---

<BaseLayout
  title="Audacity Cloud Saving Platform"
  description="Sync & save projects in Audacity Cloud. Secure, automatic, and always accessible."
  index="all"
>
  <script is:inline define:vars={{ AIX_HOST }}>
    (function () {
      // Load the AI-Experimentor snippet (one tag; self-quiet if no experiment
      // matches this path). Consent-gated because it sets a cookie + sends
      // events, matching Matomo.
      if (document.cookie.indexOf("audacity_consent=true") !== -1) {
        var s = document.createElement("script");
        s.src = AIX_HOST + "/aix.js";
        s.async = true;
        document.head.appendChild(s);
      }
    })();
  </script>

  <section class="mx-8 max-w-screen-md xl:max-w-screen-lg md:mx-auto">
    <div
      class="flex flex-col items-center justify-center"
      style="height: 90vh;"
    >
      <AppMarks />
      <div class="text-center">
        <h1
          class="font-harmony text-32 md:text-40 text-text-primary leading-tight"
        >
          Thank you for downloading Audacity!
        </h1>
        <p class="mt-2 text-18 text-text-primary/60">
          You can now complete Cloud setup
        </p>
        <ul
          class="mt-4 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-16 font-semibold text-text-primary"
        >
          {
            badges.map((badge) => (
              <li class="flex items-center gap-2">
                <span class="grid h-6 w-6 place-items-center rounded-full bg-accent/10">
                  <span class="icon icon-check icon-small leading-none text-accent" />
                </span>
                {badge}
              </li>
            ))
          }
        </ul>
      </div>
      {
        /*
        One grid, three steps. Previously the bars/circles and the labels were
        two separate 12-column grids — bar(3)+circle(1) per step against labels
        spanning 1-3, 5-7, 9-11 — so every label sat under its bar rather than
        its step, offset by half a column. Each step now owns its own bar,
        marker and label, so the label centres on the step by construction.
      */
      }
      <ol class="mt-8 grid w-full grid-cols-3 gap-x-4">
        {
          steps.map((step, i) => (
            <li class="flex flex-col items-center gap-3">
              <div class="flex w-full items-center gap-3">
                <span
                  class:list={[
                    "h-2 flex-1 rounded-full",
                    step.done ? "bg-accent" : "bg-text-primary/15",
                  ]}
                />
                <span
                  class:list={[
                    "flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-14 font-semibold",
                    step.done
                      ? "bg-accent text-white"
                      : "border border-text-primary/20 text-text-primary/40",
                  ]}
                  aria-hidden="true"
                >
                  {step.done ? (
                    <span class="icon icon-check icon-medium-small" />
                  ) : (
                    i + 1
                  )}
                </span>
              </div>
              <p
                class:list={[
                  "text-center text-16 font-semibold",
                  step.done ? "text-text-primary" : "text-text-primary/50",
                ]}
              >
                {step.label}
                <span class="sr-only">
                  {step.done ? " (done)" : " (not started)"}
                </span>
              </p>
            </li>
          ))
        }
      </ol>

      <div class="mt-12">
        <JoinAudioDotComButton
          client:load
          href="https://audio.com/audacity/auth/sign-in?mtm_campaign=audacityteamorg&mtm_content=post_download_button"
          matomoEventName="post-download CTA"
          large
        />
      </div>
    </div>
  </section>
</BaseLayout>
