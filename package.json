    "@audacity-ui/components": "0.10.3",
    "@fontsource-variable/signika": "^5.2.8",
    "@fontsource/twinkle-star": "^5.2.8",
    "@types/react": "^18.3.29",
    "@types/react-dom": "^18.3.7",
    "astro": "^7.3.3",
    "astro-compressor": "^2.0.1",
    "astro-icon": "^1.2.0",
    "astro-lazy-youtube-embed": "^0.5.5",
    "classnames": "^2.5.1",
