    "h3": "^1.15.9",
    "mdast-util-to-hast": "^13.2.1",
    "picomatch": "^4.0.5",
    "postcss": "^8.5.28",
    "rollup": "^4.59.0",
    "smol-toml": "^1.8.0",
    "svgo": "^4.1.0",
    "tar": "^7.5.16",
    "undici": "^7.29.0",
    "vite": "^8.0.13",
    "yaml": "^2.8.3"
