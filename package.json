    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@iconify-json/fa6-brands": "^1.2.6",
    "@netlify/edge-functions": "^3.0.8",
    "@pagefind/default-ui": "^1.5.2",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/typography": "^0.5.19",
