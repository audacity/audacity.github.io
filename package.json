{
  "name": "astro-audacity",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "pull-campaigns": "bun run scripts/pull-campaigns.ts",
    "extract:au4": "bun run scripts/au4-extract.ts",
